{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=external-notifications {{BIN_DIR}}/claude-tmux-notify-wrapper stop",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=external-notifications {{BIN_DIR}}/claude-tmux-notify-wrapper notification",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=external-notifications {{BIN_DIR}}/claude-tmux-notify-wrapper plan",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
