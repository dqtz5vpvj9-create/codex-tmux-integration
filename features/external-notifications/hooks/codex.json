{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=external-notifications {{BIN_DIR}}/codex-tmux-notify-wrapper stop",
            "timeout": 15,
            "statusMessage": "Sending completion notification"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=external-notifications {{BIN_DIR}}/codex-tmux-notify-wrapper notification",
            "timeout": 15,
            "statusMessage": "Sending approval notification"
          }
        ]
      }
    ]
  }
}
