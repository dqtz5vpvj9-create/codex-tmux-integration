#!/usr/bin/env python3
"""Open the model matrix from a tmux key binding.

The popup command is launched through a small wrapper because tmux expands
formats in ``display-popup`` using the popup's context.  The key binding first
passes the original socket and pane through ``run-shell``; this wrapper then
invokes ``display-popup`` with literal, already-resolved arguments.
"""

from __future__ import annotations

import argparse
import shlex
import subprocess
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--socket", required=True)
    parser.add_argument("--pane", required=True)
    return parser.parse_args()


def popup_command(helper: Path, socket: str, pane: str) -> str:
    return shlex.join([str(helper), "--socket", socket, "--pane", pane, "popup"])


def main() -> int:
    args = parse_args()
    helper = Path.home() / ".local/bin/codex-tmux-model-switch"
    command = [
        "tmux",
        "-S",
        args.socket,
        "display-popup",
        "-E",
        "-w",
        "90%",
        "-h",
        "70%",
        "-T",
        "Agent model",
        popup_command(helper, args.socket, args.pane),
    ]
    return subprocess.run(command, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
