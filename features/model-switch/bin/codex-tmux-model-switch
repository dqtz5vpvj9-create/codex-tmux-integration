#!/usr/bin/env python3
"""Low-latency tmux controller for the Codex and Claude model selectors."""

from __future__ import annotations

import argparse
import curses
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, TypeVar

REPO_ROOT = Path(__file__).resolve().parents[3]
SHARED_CONTEXT = REPO_ROOT / "shared" / "tmux-context"
if str(SHARED_CONTEXT) not in sys.path:
    sys.path.insert(0, str(SHARED_CONTEXT))

from agent_tmux_context import (  # noqa: E402
    AGENT_CLAUDE,
    AGENT_CODEX,
    AGENT_KINDS,
    agent_kind_for_pid,
)

CODEX_MODELS = (
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna",
    "gpt-5.5",
    "gpt-5.4",
    "gpt-5.4-mini",
    "gpt-5.3-codex-spark",
)
EFFORTS = (
    ("low", "Low"),
    ("medium", "Medium"),
    ("high", "High"),
    ("xhigh", "Extra high"),
    ("max", "Max"),
)
# Claude Code accepts an alias for the latest model of a family. The list is
# configurable because a local install may expose a different set.
CLAUDE_MODELS = ("opus", "sonnet", "fable", "haiku", "default")
# Model names are typed into a live pane, so only this shape is ever sent.
CLAUDE_MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._\[\]-]*$")
PRESETS = {
    "1": {AGENT_CODEX: ("gpt-5.6-sol", "max"), AGENT_CLAUDE: ("opus", "")},
    "2": {AGENT_CODEX: ("gpt-5.6-sol", "medium"), AGENT_CLAUDE: ("sonnet", "")},
    "3": {AGENT_CODEX: ("gpt-5.6-terra", "xhigh"), AGENT_CLAUDE: ("fable", "")},
    "4": {AGENT_CODEX: ("gpt-5.6-luna", "max"), AGENT_CLAUDE: ("haiku", "")},
}
POPUP_MODELS = CODEX_MODELS[:3]
POPUP_EFFORTS = (EFFORTS[0], EFFORTS[1], EFFORTS[3], EFFORTS[4])
EFFORT_MENU_LABELS = {
    "low": "low",
    "medium": "medium",
    "high": "high",
    "xhigh": "extra high",
    "max": "more reasoning",
}
EFFORT_DISPLAY_LABELS = {
    "low": ("Low", "Lo"),
    "medium": ("Medium", "Med"),
    "high": ("High", "Hi"),
    "xhigh": ("Extra high", "XHi"),
    "max": ("Max", "Max"),
}
MENU_TIMEOUT_SECONDS = 4.0
T = TypeVar("T")


class SwitchError(RuntimeError):
    pass


@dataclass
class PollStats:
    captures: int = 0
    sleep_seconds: float = 0.0
    tmux_seconds: float = 0.0


@dataclass
class Menu:
    rows: list[str]
    selected: int


class Tmux:
    def __init__(self, socket: str, pane: str) -> None:
        self.socket = socket
        self.pane = pane
        self.stats = PollStats()

    def run(
        self,
        *args: str,
        timeout: float = 0.8,
        check: bool = True,
    ) -> subprocess.CompletedProcess[str]:
        started = time.perf_counter()
        try:
            result = subprocess.run(
                ["tmux", "-S", self.socket, *args],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise SwitchError(f"tmux command failed: {error}") from error
        finally:
            self.stats.tmux_seconds += time.perf_counter() - started
        if check and result.returncode != 0:
            detail = result.stderr.strip() or f"exit {result.returncode}"
            raise SwitchError(detail)
        return result

    def detect_agent(self) -> str:
        """Return which agent owns the target pane, or fail without sending keys."""

        result = self.run(
            "display-message",
            "-p",
            "-t",
            self.pane,
            "#{pane_id}\t#{pane_pid}\t#{pane_current_command}",
        )
        parts = result.stdout.strip().split("\t")
        if len(parts) != 3 or parts[0] != self.pane:
            raise SwitchError("target pane no longer exists")
        pane_pid_text, command = parts[1:]
        try:
            pane_pid = int(pane_pid_text)
        except ValueError as error:
            raise SwitchError("target pane has no valid process identity") from error
        descendant = _descendant_agent(pane_pid)
        if descendant is not None:
            return descendant[1]
        name = Path(command).name
        if name in AGENT_KINDS:
            return name
        raise SwitchError(
            f"target pane is running {command or 'unknown'}, not Codex or Claude"
        )

    def capture(self) -> str:
        self.stats.captures += 1
        return self.run(
            "capture-pane",
            "-p",
            "-t",
            self.pane,
        ).stdout

    def send_literal(self, value: str) -> None:
        self.run("send-keys", "-t", self.pane, "-l", value)

    def send_keys(self, *keys: str) -> None:
        self.run("send-keys", "-t", self.pane, *keys)

    def message(self, value: str) -> None:
        self.run(
            "display-message",
            "-d",
            "3000",
            "-t",
            self.pane,
            value,
            check=False,
        )


def _normalized_label(value: str) -> str:
    return value.lower().replace("…", "...").strip()


def _proc_children(pid: int) -> list[int]:
    try:
        value = Path(f"/proc/{pid}/task/{pid}/children").read_text()
    except OSError:
        return []
    return [int(item) for item in value.split() if item.isdigit()]


def _descendant_agent(root_pid: int) -> tuple[int, str] | None:
    """Return the nearest agent process running below one pane."""

    pending = [root_pid]
    seen: set[int] = set()
    while pending and len(seen) < 64:
        pid = pending.pop(0)
        if pid in seen:
            continue
        seen.add(pid)
        kind = agent_kind_for_pid(pid)
        if kind:
            return pid, kind
        pending.extend(_proc_children(pid))
    return None


def claude_models() -> tuple[str, ...]:
    """Return the configured Claude model aliases offered by this install."""

    configured = os.environ.get("CODEX_TMUX_CLAUDE_MODELS", "")
    models = tuple(configured.replace(",", " ").split()) or CLAUDE_MODELS
    invalid = [model for model in models if not CLAUDE_MODEL_RE.fullmatch(model)]
    if invalid:
        raise SwitchError(f"unsupported model name: {invalid[0]}")
    return models


def parse_model_menu(screen: str) -> Menu:
    rows: dict[int, str] = {}
    selected_number = -1
    pattern = re.compile(r"^\s*([›>]?)\s*(\d+)\.\s+(gpt-[\w.-]+)", re.MULTILINE)
    for match in pattern.finditer(screen):
        number = int(match.group(2))
        rows[number] = match.group(3)
        if match.group(1):
            selected_number = number
    ordered_numbers = sorted(rows)
    ordered_rows = [rows[index] for index in ordered_numbers]
    selected = ordered_numbers.index(selected_number) if selected_number in rows else 0
    return Menu(ordered_rows, selected)


def parse_model_rows(screen: str) -> list[str]:
    return parse_model_menu(screen).rows


def parse_reasoning_menu(screen: str) -> Menu:
    rows: dict[int, str] = {}
    selected_number = -1
    pattern = re.compile(r"^\s*([›>]?)\s*(\d+)\.\s+([^\n]+)", re.MULTILINE)
    label_pattern = re.compile(
        r"^(low|medium|high|extra high|more reasoning(?:\.\.\.)?|max|ultra)"
        r"(?:\s+\((?:current|default)\))?\b"
    )
    for match in pattern.finditer(screen):
        number = int(match.group(2))
        normalized = _normalized_label(match.group(3))
        label_match = label_pattern.match(normalized)
        if label_match:
            rows[number] = label_match.group(1)
            if match.group(1):
                selected_number = number
    ordered_numbers = sorted(rows)
    ordered_rows = [rows[index] for index in ordered_numbers]
    selected = ordered_numbers.index(selected_number) if selected_number in rows else 0
    return Menu(ordered_rows, selected)


def parse_reasoning_rows(screen: str) -> list[str]:
    return parse_reasoning_menu(screen).rows


def navigation_keys(index: int, row_count: int) -> tuple[str, ...]:
    if index < 0 or index >= row_count:
        raise SwitchError(f"selection index {index} is outside {row_count} rows")
    return tuple(["Up"] * (row_count + 2) + ["Down"] * index + ["Enter"])


def relative_navigation_keys(selected: int, target: int, row_count: int) -> tuple[str, ...]:
    if selected < 0 or selected >= row_count or target < 0 or target >= row_count:
        raise SwitchError("menu selection is outside the visible rows")
    delta = target - selected
    if delta < 0:
        return tuple(["Up"] * -delta + ["Enter"])
    return tuple(["Down"] * delta + ["Enter"])


def wait_for(
    tmux: Tmux,
    parser: Callable[[str], T | None],
    description: str,
    timeout: float = MENU_TIMEOUT_SECONDS,
) -> T:
    started = time.perf_counter()
    deadline = started + timeout
    while True:
        value = parser(tmux.capture())
        if value is not None:
            return value
        now = time.perf_counter()
        if now >= deadline:
            raise SwitchError(f"timed out waiting for {description}")
        elapsed = now - started
        delay = 0.002 if elapsed < 0.05 else 0.005 if elapsed < 0.25 else 0.010
        delay = min(delay, deadline - now)
        tmux.stats.sleep_seconds += delay
        time.sleep(delay)


def _model_menu(screen: str) -> Menu | None:
    if "Select Model and Effort" not in screen:
        return None
    menu = parse_model_menu(screen)
    return menu if menu.rows else None


def _reasoning_menu(screen: str) -> Menu | None:
    if "Select Reasoning Level for" not in screen:
        return None
    menu = parse_reasoning_menu(screen)
    return menu if menu.rows else None


def _advanced_menu(screen: str) -> Menu | None:
    if "Advanced Reasoning" not in screen:
        return None
    menu = parse_reasoning_menu(screen)
    return menu if menu.rows else None


def _command_visible(previous_screen: str) -> Callable[[str], bool | None]:
    pattern = re.compile(r"^\s*›\s*/model\s*$", re.MULTILINE)

    def parse(screen: str) -> bool | None:
        if screen != previous_screen and pattern.search(screen):
            return True
        return None

    return parse


def _finished(model: str, effort: str) -> Callable[[str], bool | None]:
    expected = f"{model} {effort}".lower()

    def parse(screen: str) -> bool | None:
        lowered = screen.lower()
        if expected in lowered and "select reasoning level for" not in lowered and "advanced reasoning" not in lowered:
            return True
        return None

    return parse


def _select_row(tmux: Tmux, menu: Menu, target: str, description: str) -> None:
    try:
        index = menu.rows.index(target)
    except ValueError as error:
        raise SwitchError(f"{description} {target!r} is not available") from error
    tmux.send_keys(*relative_navigation_keys(menu.selected, index, len(menu.rows)))


def _screen_changed(previous_screen: str) -> Callable[[str], bool | None]:
    def parse(screen: str) -> bool | None:
        return True if screen != previous_screen else None

    return parse


def _claude_command_visible(
    previous_screen: str, command: str
) -> Callable[[str], bool | None]:
    pattern = re.compile(re.escape(command) + r"(?=\s|$)")

    def parse(screen: str) -> bool | None:
        if screen != previous_screen and pattern.search(screen):
            return True
        return None

    return parse


def apply_claude_model(tmux: Tmux, model: str) -> PollStats:
    """Submit ``/model <alias>`` and let Claude Code validate the alias.

    Claude echoes a submitted slash command into its transcript, so completion
    is confirmed by the screen advancing past the composed command rather than
    by the command text disappearing.
    """

    if model not in claude_models():
        raise SwitchError(f"unsupported model preset: {model}")
    command = f"/model {model}"
    previous_screen = tmux.capture()
    tmux.send_literal(command)
    wait_for(tmux, _claude_command_visible(previous_screen, command), "the /model command input")
    composed_screen = tmux.capture()
    tmux.send_keys("Enter")
    wait_for(tmux, _screen_changed(composed_screen), "the /model command to be accepted")
    return tmux.stats


def apply_switch(tmux: Tmux, model: str, effort: str) -> PollStats:
    if model not in CODEX_MODELS:
        raise SwitchError(f"unsupported model preset: {model}")
    if effort not in EFFORT_MENU_LABELS:
        raise SwitchError(f"unsupported reasoning effort: {effort}")

    previous_screen = tmux.capture()
    tmux.send_literal("/model")
    wait_for(tmux, _command_visible(previous_screen), "the /model command input")
    tmux.send_keys("Enter")

    models = wait_for(tmux, _model_menu, "the model menu")
    _select_row(tmux, models, model, "model")

    reasoning = wait_for(tmux, _reasoning_menu, "the reasoning menu")
    target_label = EFFORT_MENU_LABELS[effort]
    matching = next((row for row in reasoning.rows if row.startswith(target_label)), None)
    if matching is None:
        raise SwitchError(f"reasoning effort {effort!r} is not available")
    _select_row(tmux, reasoning, matching, "reasoning effort")

    if effort == "max":
        advanced = wait_for(tmux, _advanced_menu, "the advanced reasoning menu")
        matching = next((row for row in advanced.rows if row.startswith("max")), None)
        if matching is None:
            raise SwitchError("Max is not available in Advanced Reasoning")
        _select_row(tmux, advanced, matching, "advanced reasoning effort")

    wait_for(tmux, _finished(model, effort), "the final model status")
    return tmux.stats


def _current_selection(screen: str) -> tuple[int, int]:
    lowered = screen.lower()
    pairs = re.findall(
        r"\b(gpt-[\w.-]+)\s+(low|medium|high|xhigh|max)\s+·", lowered
    )
    if not pairs:
        pairs = re.findall(r"\b(gpt-[\w.-]+)\s+(low|medium|high|xhigh|max)\b", lowered)
    model_name, effort_name = pairs[-1] if pairs else ("", "medium")
    model_index = next((i for i, model in enumerate(POPUP_MODELS) if model == model_name), 0)
    effort_index = next(
        (i for i, (effort, _label) in enumerate(POPUP_EFFORTS) if effort == effort_name),
        1,
    )
    return model_index, effort_index


def _addnstr(
    stdscr: curses.window,
    y: int,
    x: int,
    value: str,
    max_chars: int,
    attribute: int = curses.A_NORMAL,
) -> None:
    """Draw clipped text without failing at a popup's right/bottom edge."""

    height, width = stdscr.getmaxyx()
    if y < 0 or y >= height or x < 0 or x >= width or max_chars <= 0:
        return
    available = min(max_chars, width - x)
    if available <= 0:
        return
    try:
        stdscr.addnstr(y, x, value, available, attribute)
    except curses.error:
        # ncurses can still return ERR when a clipped write ends exactly at
        # the lower-right cell of a small popup.
        return


def _grid_layout(width: int) -> tuple[int, int, int]:
    model_width = max(len(model) for model in POPUP_MODELS) + 2
    cell_width = max(1, min(13, (width - model_width - 2) // len(POPUP_EFFORTS)))
    total_width = model_width + cell_width * len(POPUP_EFFORTS)
    left = max(0, (width - total_width) // 2)
    return model_width, cell_width, left


def _effort_display(effort: str, cell_width: int) -> str:
    full, short = EFFORT_DISPLAY_LABELS[effort]
    if cell_width >= len(full) + 1:
        return full
    return short[: max(1, cell_width - 1)]


def _draw_grid(stdscr: curses.window, selected_model: int, selected_effort: int) -> None:
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    title = "Codex model × reasoning"
    help_text = "arrows/hjkl move · Enter switch · Esc/q cancel"
    _addnstr(stdscr, 1, max(0, (width - len(title)) // 2), title, width, curses.A_BOLD)
    _addnstr(stdscr, 2, max(0, (width - len(help_text)) // 2), help_text, width, curses.A_DIM)

    model_width, cell_width, left = _grid_layout(width)
    top = 4
    _addnstr(stdscr, top, left, "Model", model_width - 1, curses.A_BOLD)
    for column, (effort, _label) in enumerate(POPUP_EFFORTS):
        label = _effort_display(effort, cell_width)
        x = left + model_width + column * cell_width
        _addnstr(stdscr, top, x, label.center(max(1, cell_width - 1)), cell_width - 1, curses.A_BOLD)

    for row, model in enumerate(POPUP_MODELS):
        y = top + 2 + row
        if y >= height - 1:
            break
        _addnstr(stdscr, y, left, model, model_width - 1)
        for column, (effort, _label) in enumerate(POPUP_EFFORTS):
            selected = row == selected_model and column == selected_effort
            label = _effort_display(effort, cell_width)
            inner_width = max(1, cell_width - 2)
            text = f"[{label[:inner_width].center(inner_width)}]"
            attribute = curses.A_REVERSE | curses.A_BOLD if selected else curses.A_NORMAL
            x = left + model_width + column * cell_width
            _addnstr(stdscr, y, x, text, cell_width, attribute)
    stdscr.refresh()


def _grid(stdscr: curses.window, model_index: int, effort_index: int) -> tuple[str, str] | None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    stdscr.keypad(True)
    while True:
        _draw_grid(stdscr, model_index, effort_index)
        key = stdscr.getch()
        if key in (27, ord("q")):
            return None
        if key in (curses.KEY_UP, ord("k")):
            model_index = (model_index - 1) % len(POPUP_MODELS)
        elif key in (curses.KEY_DOWN, ord("j")):
            model_index = (model_index + 1) % len(POPUP_MODELS)
        elif key in (curses.KEY_LEFT, ord("h")):
            effort_index = (effort_index - 1) % len(POPUP_EFFORTS)
        elif key in (curses.KEY_RIGHT, ord("l")):
            effort_index = (effort_index + 1) % len(POPUP_EFFORTS)
        elif key in (curses.KEY_ENTER, 10, 13):
            return POPUP_MODELS[model_index], POPUP_EFFORTS[effort_index][0]


def _draw_list(stdscr: curses.window, models: tuple[str, ...], selected: int) -> None:
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    title = "Claude model"
    help_text = "up/down or j/k move · Enter switch · Esc/q cancel"
    _addnstr(stdscr, 1, max(0, (width - len(title)) // 2), title, width, curses.A_BOLD)
    _addnstr(stdscr, 2, max(0, (width - len(help_text)) // 2), help_text, width, curses.A_DIM)
    cell_width = max(len(model) for model in models) + 4
    left = max(0, (width - cell_width) // 2)
    for row, model in enumerate(models):
        y = 4 + row
        if y >= height - 1:
            break
        attribute = curses.A_REVERSE | curses.A_BOLD if row == selected else curses.A_NORMAL
        _addnstr(stdscr, y, left, f" {model} ".center(cell_width), cell_width, attribute)
    stdscr.refresh()


def _list(stdscr: curses.window, models: tuple[str, ...]) -> str | None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    stdscr.keypad(True)
    selected = 0
    while True:
        _draw_list(stdscr, models, selected)
        key = stdscr.getch()
        if key in (27, ord("q")):
            return None
        if key in (curses.KEY_UP, ord("k")):
            selected = (selected - 1) % len(models)
        elif key in (curses.KEY_DOWN, ord("j")):
            selected = (selected + 1) % len(models)
        elif key in (curses.KEY_ENTER, 10, 13):
            return models[selected]


def popup_selection(tmux: Tmux, kind: str) -> tuple[str, str] | None:
    if kind == AGENT_CLAUDE:
        model = curses.wrapper(_list, claude_models())
        return (model, "") if model else None
    model_index, effort_index = _current_selection(tmux.capture())
    return curses.wrapper(_grid, model_index, effort_index)


def resolve_selection(kind: str, args: argparse.Namespace) -> tuple[str, str]:
    """Map command line arguments onto one agent's own selection vocabulary."""

    if args.preset:
        return PRESETS[args.preset][kind]
    model = str(args.model or "")
    effort = str(args.effort or "")
    if not model:
        raise SwitchError("--model or --preset is required")
    if kind == AGENT_CLAUDE:
        return model, ""
    if not effort:
        raise SwitchError("--effort is required for Codex")
    return model, effort


def _lock(socket: str, pane: str):
    digest = hashlib.sha256(f"{socket}\0{pane}".encode()).hexdigest()[:16]
    path = Path(tempfile.gettempdir()) / f"codex-tmux-model-{os.getuid()}-{digest}.lock"
    descriptor = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    stream = os.fdopen(descriptor, "w")
    try:
        fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        stream.close()
        raise SwitchError("another model switch is already running")
    return stream


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--socket", required=True)
    parser.add_argument("--pane", required=True)
    subparsers = parser.add_subparsers(dest="command", required=True)
    apply_parser = subparsers.add_parser("apply")
    apply_parser.add_argument("--preset", choices=sorted(PRESETS))
    apply_parser.add_argument("--model")
    apply_parser.add_argument("--effort", choices=[item[0] for item in EFFORTS])
    subparsers.add_parser("popup")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    tmux = Tmux(args.socket, args.pane)
    started = time.perf_counter()
    lock_stream = None
    try:
        lock_stream = _lock(args.socket, args.pane)
        kind = tmux.detect_agent()
        if args.command == "popup":
            selected = popup_selection(tmux, kind)
            if selected is None:
                return 0
            model, effort = selected
        else:
            model, effort = resolve_selection(kind, args)
        stats = (
            apply_claude_model(tmux, model)
            if kind == AGENT_CLAUDE
            else apply_switch(tmux, model, effort)
        )
        elapsed_ms = (time.perf_counter() - started) * 1000
        active_ms = max(0.0, elapsed_ms - stats.sleep_seconds * 1000)
        if os.environ.get("CODEX_TMUX_MODEL_METRICS") == "1":
            print(
                json.dumps(
                    {
                        "agent": kind,
                        "model": model,
                        "effort": effort,
                        "total_ms": round(elapsed_ms, 3),
                        "active_ms": round(active_ms, 3),
                        "sleep_ms": round(stats.sleep_seconds * 1000, 3),
                        "tmux_ms": round(stats.tmux_seconds * 1000, 3),
                        "captures": stats.captures,
                    },
                    sort_keys=True,
                )
            )
        return 0
    except SwitchError as error:
        tmux.message(f"model switch failed: {error}")
        print(f"codex-tmux-model-switch: {error}", file=sys.stderr)
        return 1
    finally:
        if lock_stream is not None:
            lock_stream.close()


if __name__ == "__main__":
    raise SystemExit(main())
