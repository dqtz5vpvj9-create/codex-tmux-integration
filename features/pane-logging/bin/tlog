#!/usr/bin/env python3
"""List and open bounded logs across default and registered tmux sockets."""

from __future__ import annotations

import argparse
import hashlib
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parents[3]
RUNTIME_ROOT = REPO_ROOT / "shared" / "tmux-runtime"
if str(RUNTIME_ROOT) not in sys.path:
    sys.path.insert(0, str(RUNTIME_ROOT))

from tmux_runtime import live_sockets, server_pid, socket_from_tmux_env  # noqa: E402

LOGDIR = Path(os.environ.get("TMUX_PANE_LOGDIR", Path.home() / ".cache/tmux-pane-logs"))
ANSI_RE = re.compile(rb"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[()=>][AB012]?)")


def safe_key(value: Any) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]", "_", str(value or ""))


def server_key(socket: str, pid: int) -> str:
    digest = hashlib.sha256(f"{socket}\0{pid}".encode()).hexdigest()[:12]
    return f"{safe_key(Path(socket).name)}-{pid}-{digest}"


def log_file(socket: str, pane: str) -> Path:
    return LOGDIR / server_key(socket, server_pid(socket)) / f"{pane.removeprefix('%')}.log"


def tmux(socket: str, *args: str) -> str:
    try:
        result = subprocess.run(
            ["tmux", "-S", socket, *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=1,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def panes() -> list[dict[str, str]]:
    rows = []
    for socket in live_sockets():
        raw = tmux(
            socket,
            "list-panes",
            "-a",
            "-F",
            "#{window_name}\t#{pane_id}\t#{pane_current_command}",
        )
        for line in raw.splitlines():
            parts = line.split("\t", 2)
            if len(parts) == 3:
                rows.append(
                    {
                        "socket": socket,
                        "server": Path(socket).name,
                        "window": parts[0],
                        "pane": parts[1],
                        "command": parts[2],
                    }
                )
    return rows


def list_logs() -> None:
    print(f"{'SERVER':22} {'WINDOW':36} {'PANE':7} {'COMMAND':12} {'SIZE':10} FILE")
    for row in panes():
        path = log_file(row["socket"], row["pane"])
        size = str(path.stat().st_size) if path.is_file() else "-"
        file_text = str(path) if path.is_file() else "-"
        print(
            f"{row['server'][:22]:22} {row['window'][:36]:36} {row['pane']:7} "
            f"{row['command'][:12]:12} {size:10} {file_text}"
        )


def resolve(query: str) -> dict[str, str]:
    requested_server = ""
    requested_value = query
    if ":%" in query:
        requested_server, pane_number = query.split(":%", 1)
        requested_value = f"%{pane_number}"
    current_socket = socket_from_tmux_env()
    matches = []
    for row in panes():
        if requested_server and row["server"] != requested_server:
            continue
        if not requested_server and requested_value.startswith("%") and current_socket:
            if row["socket"] != current_socket:
                continue
        if requested_value.startswith("%"):
            matched = row["pane"] == requested_value
        else:
            matched = requested_value in row["window"]
        if matched:
            matches.append(row)
    if not matches:
        raise SystemExit(f"no match for: {query}")
    if len(matches) > 1:
        choices = "\n".join(f"  {row['server']}:{row['pane']}" for row in matches)
        raise SystemExit(f"ambiguous match for {query!r}; use server:%pane:\n{choices}")
    return matches[0]


def stripped_stream(path: Path):
    with path.open("rb") as stream:
        for line in stream:
            yield ANSI_RE.sub(b"", line).replace(b"\r\n", b"\n")


def view(path: Path, raw: bool, follow: bool) -> None:
    if not path.is_file():
        raise SystemExit(f"no log file: {path}")
    if follow:
        command = ["tail", "-F", str(path)]
        if raw:
            raise SystemExit(subprocess.call(command))
        process = subprocess.Popen(command, stdout=subprocess.PIPE)
        assert process.stdout is not None
        try:
            for line in process.stdout:
                sys.stdout.buffer.write(ANSI_RE.sub(b"", line))
                sys.stdout.buffer.flush()
        finally:
            process.terminate()
        return
    pager = shutil.which("less")
    if pager:
        pager_args = [pager]
        if raw:
            pager_args.append("-R")
        pager_args.append("+G")
        process = subprocess.Popen(pager_args, stdin=subprocess.PIPE)
        assert process.stdin is not None
        if raw:
            with path.open("rb") as stream:
                shutil.copyfileobj(stream, process.stdin)
        else:
            for line in stripped_stream(path):
                process.stdin.write(line)
        process.stdin.close()
        process.wait()
    elif raw:
        sys.stdout.buffer.write(path.read_bytes())
    else:
        for line in stripped_stream(path):
            sys.stdout.buffer.write(line)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    parser.add_argument("query", nargs="?")
    parser.add_argument("-r", "--raw", action="store_true")
    parser.add_argument("-f", "--follow", action="store_true")
    parser.add_argument("-l", "--list", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.list or not args.query:
        list_logs()
        return 0
    row = resolve(args.query)
    view(log_file(row["socket"], row["pane"]), args.raw, args.follow)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
