#!/usr/bin/env python3
"""Synchronize a tmux window with the active Codex pane and restore it safely."""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import signal
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterator

REPO_ROOT = Path(__file__).resolve().parents[3]
SHARED_CONTEXT = REPO_ROOT / "shared" / "tmux-context"
if str(SHARED_CONTEXT) not in sys.path:
    sys.path.insert(0, str(SHARED_CONTEXT))

from agent_tmux_context import (  # noqa: E402
    AGENT_CLAUDE,
    AGENT_CODEX,
    agent_processes_for_target,
    claude_session_record,
    claude_transcripts_for_session,
    process_is_alive,
    process_start_time,
    resolve_hook_target_details,
)

MAX_TITLE = 48
TMUX_TIMEOUT_SECONDS = 1.0
PIDLESS_STATE_TTL_SECONDS = 60
WATCH_INTERVAL_SECONDS = 0.5
WATCH_START_GRACE_SECONDS = 10.0
WATCH_CONTEXT_GRACE_SECONDS = 10.0
WATCH_RECONCILE_INTERVAL_SECONDS = 2.0
WATCHER_VERSION = 2
GENERIC_WINDOW_TITLES = {"codex", "claude"}
CODEX_HOME = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
SESSION_INDEX_PATH = CODEX_HOME / "session_index.jsonl"
CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
CLAUDE_SESSIONS_ROOT = CLAUDE_HOME / "sessions"
CLAUDE_PROJECTS_ROOT = CLAUDE_HOME / "projects"
# Claude Code appends one ``ai-title`` record per assistant turn, so the newest
# chat title is always near the end of a transcript.
CLAUDE_TITLE_SCAN_LINES = 200
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
STATE_ROOT = CACHE_HOME / "codex-tmux-integration" / "title-sync"
SESSION_REGISTRY_PATH = Path(
    os.environ.get(
        "CODEX_SESSION_REGISTRY",
        Path.home() / ".local/state/codex-tmux-integration/sessions.json",
    )
)
SESSION_REGISTRY_SCHEMA = "codex.session-registry.v1"
SESSION_REGISTRY_SOURCE = "session-listener"
LOG_PATH = Path(
    os.environ.get(
        "CODEX_TMUX_TITLE_LOG",
        CACHE_HOME / "codex-tmux-integration" / "title-sync.log",
    )
)
LOG_MAX_BYTES = 512 * 1024
UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)
RENAMED_SESSION_RE = re.compile(
    r"Session renamed to (?P<title>.+?)\. To resume this session run codex resume,\s*"
    r"then select .+? \((?P<session>[0-9a-fA-F-]{36})\)"
)
STATUS_SESSION_RE = re.compile(
    r"\bSession:\s*(?P<session>[0-9a-fA-F-]{36})\b"
)
STATUS_MODE_RE = re.compile(r"^(?:Main|Plan)\s+\[[^\]]+\](?:\s+.*)?$")


def log(message: Any) -> None:
    try:
        LOG_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if LOG_PATH.exists() and LOG_PATH.stat().st_size >= LOG_MAX_BYTES:
            LOG_PATH.replace(LOG_PATH.with_suffix(LOG_PATH.suffix + ".1"))
        stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
        with LOG_PATH.open("a", encoding="utf-8") as stream:
            stream.write(f"{stamp} {str(message).rstrip()}\n")
    except OSError:
        pass


def clean(value: Any) -> str:
    text = str(value or "")
    text = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", text)
    text = re.sub(r"[\x00-\x1f\x7f]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def shorten(value: Any, max_len: int = MAX_TITLE) -> str:
    text = clean(value)
    if len(text) <= max_len:
        return text
    return text[: max(0, max_len - 3)].rstrip() + "..."


def as_int(value: Any, default: int = -1) -> int:
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return default


def safe_key(value: Any) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]", "_", str(value or ""))


def server_key(socket: str, server_pid: int = -1) -> str:
    socket = str(socket or "default")
    name = safe_key(Path(socket).name) or "default"
    identity = f"{socket}\0{server_pid}"
    digest = hashlib.sha256(identity.encode("utf-8", errors="replace")).hexdigest()[:12]
    return f"{name}-{server_pid}-{digest}"


def tmux_command(socket: str | None = None) -> list[str]:
    command = ["tmux"]
    if socket:
        command.extend(["-S", socket])
    return command


def tmux_result(*args: str, socket: str | None = None) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(
            [*tmux_command(socket), *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=TMUX_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def tmux(*args: str, socket: str | None = None) -> str:
    result = tmux_result(*args, socket=socket)
    if result is None or result.returncode != 0:
        return ""
    return result.stdout.strip()


def tmux_socket_from_env(env: dict[str, str] | os._Environ[str]) -> str:
    raw = str(env.get("TMUX") or "")
    return raw.rsplit(",", 2)[0] if raw else ""


def current_server_pid(socket: str) -> int:
    return as_int(tmux("display-message", "-p", "#{pid}", socket=socket))


def pane_context(pane: str, socket: str | None = None) -> dict[str, Any] | None:
    raw = tmux(
        "display-message",
        "-p",
        "-t",
        pane,
        "#{pid}\t#{pane_pid}\t#{window_id}\t#{pane_active}\t#{pane_dead}",
        socket=socket,
    )
    parts = raw.split("\t")
    if len(parts) != 5:
        return None
    return {
        "server_pid": as_int(parts[0]),
        "pane_pid": as_int(parts[1]),
        "window_id": clean(parts[2]),
        "pane_active": parts[3] == "1",
        "pane_dead": parts[4] == "1",
    }


def window_active_pane(window: str, socket: str) -> str:
    raw = tmux(
        "list-panes",
        "-t",
        window,
        "-f",
        "#{pane_active}",
        "-F",
        "#{pane_id}",
        socket=socket,
    )
    return clean(raw.splitlines()[0]) if raw else ""


def window_name(window: str, socket: str) -> str:
    return clean(
        tmux("display-message", "-p", "-t", window, "#{window_name}", socket=socket)
    )


def window_automatic_rename(window: str, socket: str) -> bool:
    value = clean(
        tmux(
            "display-message",
            "-p",
            "-t",
            window,
            "#{automatic-rename}",
            socket=socket,
        )
    ).lower()
    if value in {"0", "off", "false", "no"}:
        return False
    if value in {"1", "on", "true", "yes"}:
        return True
    return True


def set_window_automatic_rename(window: str, enabled: bool, socket: str) -> bool:
    result = tmux_result(
        "set-window-option",
        "-t",
        window,
        "automatic-rename",
        "on" if enabled else "off",
        socket=socket,
    )
    return result is not None and result.returncode == 0


def rename_window(window: str, title: str, socket: str) -> bool:
    title = shorten(title)
    if not title:
        return False
    if window_name(window, socket) == title:
        return True
    result = tmux_result("rename-window", "-t", window, title, socket=socket)
    if result is not None and result.returncode == 0:
        log(f"renamed socket={socket!r} window={window} title={title!r}")
        return True
    return False


def _server_root(socket: str, server_pid: int) -> Path:
    return STATE_ROOT / "servers" / server_key(socket, server_pid)


def pane_state_path(socket: str, server_pid: int, pane: str) -> Path:
    return _server_root(socket, server_pid) / "panes" / f"{safe_key(pane)}.json"


def window_state_path(socket: str, server_pid: int, window: str) -> Path:
    return _server_root(socket, server_pid) / "windows" / f"{safe_key(window)}.json"


def lock_path(socket: str, server_pid: int, window: str) -> Path:
    return _server_root(socket, server_pid) / "locks" / f"{safe_key(window)}.lock"


def watcher_state_path(socket: str, server_pid: int, pane: str) -> Path:
    return _server_root(socket, server_pid) / "watchers" / f"{safe_key(pane)}.json"


def watcher_lock_path(socket: str, server_pid: int, pane: str) -> Path:
    return _server_root(socket, server_pid) / "watchers" / f"{safe_key(pane)}.lock"


def atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        temporary.write_text(
            json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        temporary.chmod(0o600)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def read_json(path: Path) -> dict[str, Any] | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return value if isinstance(value, dict) else None


@contextlib.contextmanager
def window_lock(socket: str, server_pid: int, window: str) -> Iterator[None]:
    path = lock_path(socket, server_pid, window)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as stream:
        os.chmod(path, 0o600)
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def cache_pane_title(
    socket: str,
    pane: str,
    title: str,
    session_id: str = "",
    *,
    agent_pid: int = -1,
    agent_start_time: int = -1,
    provisional: bool = False,
    source: str = "",
) -> bool:
    context = pane_context(pane, socket=socket)
    if context is None or not title or context["pane_dead"]:
        return False
    payload = {
        "version": 2,
        "socket": socket,
        "server_pid": context["server_pid"],
        "pane": pane,
        "pane_pid": context["pane_pid"],
        "window_id": context["window_id"],
        "title": shorten(title),
        "session_id": clean(session_id),
        "agent_pid": agent_pid,
        "agent_start_time": agent_start_time,
        "provisional": provisional,
        "source": clean(source),
        "updated_at_ns": time.time_ns(),
    }
    try:
        atomic_write_json(
            pane_state_path(socket, context["server_pid"], pane),
            payload,
        )
    except OSError:
        return False
    return True


def _delete_state(path: Path) -> None:
    try:
        path.unlink()
    except OSError:
        pass


def _cached_pane_state_for_context(
    socket: str,
    pane: str,
    context: dict[str, Any] | None,
) -> dict[str, Any] | None:
    if context is None or context["pane_dead"]:
        return None
    path = pane_state_path(socket, context["server_pid"], pane)
    payload = read_json(path)
    if payload is None:
        return None
    if (
        payload.get("socket") != socket
        or payload.get("pane") != pane
        or as_int(payload.get("server_pid")) != context["server_pid"]
        or as_int(payload.get("pane_pid")) != context["pane_pid"]
        or payload.get("window_id") != context["window_id"]
    ):
        _delete_state(path)
        return None

    agent_pid = as_int(payload.get("agent_pid"))
    agent_start_time = as_int(payload.get("agent_start_time"))
    if agent_pid > 0 and not process_is_alive(agent_pid, agent_start_time):
        _delete_state(path)
        return None
    if agent_pid <= 0:
        age_seconds = max(0, time.time_ns() - as_int(payload.get("updated_at_ns"), 0)) / 1e9
        if age_seconds > PIDLESS_STATE_TTL_SECONDS:
            _delete_state(path)
            return None
    title = shorten(payload.get("title"))
    return payload if title else None


def cached_pane_state(socket: str, pane: str) -> dict[str, Any] | None:
    return _cached_pane_state_for_context(
        socket,
        pane,
        pane_context(pane, socket=socket),
    )


def cached_pane_title(socket: str, pane: str) -> str:
    payload = cached_pane_state(socket, pane)
    return shorten(payload.get("title")) if payload else ""


def _reverse_lines(path: Path, block_size: int = 64 * 1024) -> Iterator[str]:
    with path.open("rb") as stream:
        stream.seek(0, os.SEEK_END)
        position = stream.tell()
        buffer = b""
        while position > 0:
            size = min(block_size, position)
            position -= size
            stream.seek(position)
            buffer = stream.read(size) + buffer
            lines = buffer.split(b"\n")
            buffer = lines[0]
            for line in reversed(lines[1:]):
                if line:
                    yield line.decode("utf-8", errors="replace")
        if buffer:
            yield buffer.decode("utf-8", errors="replace")


def thread_name_for_session(session_id: str) -> str:
    session_id = clean(session_id)
    if not session_id or not SESSION_INDEX_PATH.exists():
        return ""
    try:
        for line in _reverse_lines(SESSION_INDEX_PATH):
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if clean(record.get("id")) == session_id:
                return clean(record.get("thread_name"))
    except OSError:
        return ""
    return ""


def file_stamp(path: Path) -> tuple[int, int]:
    """Return a cheap change token for one file without reading it."""

    try:
        stat = path.stat()
    except OSError:
        return (0, 0)
    return (stat.st_mtime_ns, stat.st_size)


def session_index_stamp() -> tuple[int, int]:
    return file_stamp(SESSION_INDEX_PATH)


def read_session_registry(path: Path = SESSION_REGISTRY_PATH) -> dict[str, Any] | None:
    """Read only the private metadata registry produced by the eBPF listener."""

    try:
        metadata = path.stat()
        if metadata.st_uid != os.getuid() or metadata.st_mode & 0o022:
            return None
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(payload, dict) or payload.get("schema") != SESSION_REGISTRY_SCHEMA:
        return None
    return payload if isinstance(payload.get("connections"), dict) else None


def session_registry_active(path: Path = SESSION_REGISTRY_PATH) -> bool:
    return read_session_registry(path) is not None


def session_id_from_transcript(path: str | Path) -> str:
    try:
        with Path(path).open("r", encoding="utf-8", errors="replace") as stream:
            for _ in range(16):
                line = stream.readline()
                if not line:
                    break
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if record.get("type") == "session_meta":
                    return clean((record.get("payload") or {}).get("id"))
    except OSError:
        pass
    return ""


def claude_transcript_title(path: str | Path) -> str:
    """Return the newest chat title Claude Code recorded in one transcript."""

    if not path:
        return ""
    try:
        for index, line in enumerate(_reverse_lines(Path(path))):
            if index >= CLAUDE_TITLE_SCAN_LINES:
                break
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if record.get("type") == "ai-title":
                return clean(record.get("aiTitle"))
    except OSError:
        return ""
    return ""


def claude_transcript_for_session(session_id: str) -> str:
    paths = claude_transcripts_for_session(session_id, os.environ)
    return paths[0] if paths else ""


def claude_session_title(
    session_id: str,
    transcript_path: str | Path = "",
    record: dict[str, Any] | None = None,
) -> str:
    """Prefer a name the user chose, then Claude's own chat title."""

    record = record or {}
    name = shorten(record.get("name"))
    if name and clean(record.get("nameSource")) not in {"", "derived"}:
        return name
    title = shorten(claude_transcript_title(transcript_path))
    if title:
        return title
    if name:
        return name
    session_id = clean(session_id)
    if session_id:
        return shorten(f"claude-{session_id.split('-', 1)[0][:8]}")
    return "claude"


def claude_observation(agent_pid: int, transcript: str = "") -> tuple[str, str]:
    """Read a live Claude session name without capturing its pane."""

    record = claude_session_record(agent_pid)
    session_id = clean(record.get("sessionId"))
    if not session_id:
        return "", ""
    transcript = transcript or claude_transcript_for_session(session_id)
    return claude_session_title(session_id, transcript, record), session_id


def derive_claude_title(process: dict[str, Any]) -> tuple[str, str]:
    record = process.get("session") or {}
    session_id = clean(record.get("sessionId")) or clean(process.get("resume"))
    transcripts = [str(path) for path in process.get("transcripts", [])]
    title = claude_session_title(
        session_id, transcripts[0] if transcripts else "", record
    )
    return shorten(title), session_id


def derive_process_title(process: dict[str, Any]) -> tuple[str, str]:
    if clean(process.get("agent_kind")) == AGENT_CLAUDE:
        return derive_claude_title(process)
    transcripts = [str(path) for path in process.get("transcripts", [])]
    for transcript in transcripts:
        session_id = session_id_from_transcript(transcript)
        if not session_id:
            continue
        name = thread_name_for_session(session_id)
        return shorten(name or f"codex-{session_id.split('-', 1)[0][:8]}"), session_id
    resume = clean(process.get("resume"))
    if resume:
        if UUID_RE.fullmatch(resume):
            name = thread_name_for_session(resume)
            return shorten(name or f"codex-{resume.split('-', 1)[0][:8]}"), resume
        return shorten(resume), ""
    return "codex", ""


def path_is_under(path: str | Path, root: Path) -> bool:
    try:
        resolved = Path(path).expanduser().resolve(strict=False)
        resolved.relative_to(root.expanduser().resolve(strict=False))
    except (OSError, ValueError):
        return False
    return True


def hook_agent_kind(payload: dict[str, Any], target: dict[str, Any]) -> str:
    """Identify which agent produced one hook payload.

    The resolved process identity is authoritative. A detached hook runner may
    leave it empty, in which case the transcript location still separates the
    two agents because each writes below its own home directory.
    """

    kind = clean(target.get("agent_kind"))
    if kind:
        return kind
    transcript = clean(payload.get("transcript_path"))
    if transcript:
        if path_is_under(transcript, CLAUDE_PROJECTS_ROOT):
            return AGENT_CLAUDE
        if path_is_under(transcript, CODEX_HOME / "sessions"):
            return AGENT_CODEX
    return AGENT_CODEX


def title_for_hook(
    payload: dict[str, Any],
    kind: str = AGENT_CODEX,
    agent_pid: int = -1,
) -> tuple[str, str]:
    session_id = clean(payload.get("session_id"))
    if not session_id:
        return "", ""
    if kind == AGENT_CLAUDE:
        record = claude_session_record(agent_pid) if agent_pid > 0 else {}
        if clean(record.get("sessionId")) != session_id:
            record = {}
        transcript = clean(payload.get("transcript_path")) or (
            claude_transcript_for_session(session_id)
        )
        return claude_session_title(session_id, transcript, record), session_id
    name = thread_name_for_session(session_id)
    return shorten(name or f"codex-{session_id.split('-', 1)[0][:8]}"), session_id


def codex_status_from_capture(raw: str) -> tuple[str, str]:
    """Read the current chat title and any explicit session id from Codex TUI."""

    lines = [clean(line) for line in str(raw or "").splitlines()]
    status_title = ""
    for line in reversed(lines):
        before_mode, separator, mode = line.rpartition(" · ")
        if not separator or STATUS_MODE_RE.fullmatch(mode) is None:
            continue
        _, title_separator, candidate = before_mode.rpartition(" · ")
        if title_separator:
            status_title = clean(candidate)
            break
    if UUID_RE.fullmatch(status_title):
        return status_title, status_title

    # Codex 0.147 no longer includes the chat title/UUID in its footer. Use
    # explicit identity emitted by `/status` or `/rename` instead. Normalize
    # the whole capture because the rename notification can wrap across rows.
    normalized = clean(raw)
    explicit: list[tuple[int, str, str, str]] = []
    for match in STATUS_SESSION_RE.finditer(normalized):
        explicit.append((match.start(), "status", "", clean(match.group("session"))))
    for match in RENAMED_SESSION_RE.finditer(normalized):
        explicit.append(
            (
                match.start(),
                "rename",
                clean(match.group("title")),
                clean(match.group("session")),
            )
        )
    if explicit:
        _, source, explicit_title, session_id = max(explicit, key=lambda item: item[0])
        if UUID_RE.fullmatch(session_id):
            if source == "status":
                return status_title or session_id, session_id
            if not status_title or status_title == explicit_title:
                return explicit_title, session_id
    return status_title, ""


def pane_codex_status(socket: str, pane: str) -> tuple[str, str]:
    raw = tmux(
        "capture-pane",
        "-p",
        "-J",
        "-t",
        pane,
        "-S",
        "-30",
        socket=socket,
    )
    return codex_status_from_capture(raw)


def apply_pane_observation(
    socket: str,
    pane: str,
    status_title: str,
    observed_session_id: str,
    *,
    agent_pid: int,
    agent_start_time: int,
    window: str = "",
    agent_kind: str = AGENT_CODEX,
) -> int:
    """Cache one same-pane observation and reconcile its owning window."""

    status_title = shorten(status_title)
    if not status_title:
        return 0
    state = cached_pane_state(socket, pane)
    session_id = clean(observed_session_id)
    title = status_title
    if agent_kind != AGENT_CLAUDE:
        if not session_id and state is not None:
            previous_session = clean(state.get("session_id"))
            if previous_session and thread_name_for_session(previous_session) == status_title:
                session_id = previous_session
        if UUID_RE.fullmatch(status_title):
            session_id = status_title
            name = thread_name_for_session(session_id)
            title = shorten(name or f"codex-{session_id.split('-', 1)[0][:8]}")

    if (
        state is not None
        and shorten(state.get("title")) == title
        and clean(state.get("session_id")) == session_id
        and as_int(state.get("agent_pid")) == agent_pid
        and as_int(state.get("agent_start_time")) == agent_start_time
        and not bool(state.get("provisional"))
    ):
        current_name = window_name(window, socket) if window else ""
        if current_name in GENERIC_WINDOW_TITLES and current_name != title:
            return reconcile_window(socket, window)
        return 0
    if not cache_pane_title(
        socket,
        pane,
        title,
        session_id,
        agent_pid=agent_pid,
        agent_start_time=agent_start_time,
    ):
        return 0
    if not window:
        context = pane_context(pane, socket=socket)
        window = clean((context or {}).get("window_id"))
    return reconcile_window(socket, window) if window else 0


def bound_session_observation(
    socket: str,
    pane: str,
    *,
    agent_pid: int,
    agent_start_time: int,
    context: dict[str, Any] | None = None,
) -> tuple[str, str] | None:
    """Read a bound pane's current title directly from the session index."""

    state = (
        _cached_pane_state_for_context(socket, pane, context)
        if context is not None
        else cached_pane_state(socket, pane)
    )
    if state is None or bool(state.get("provisional")):
        return None
    session_id = clean(state.get("session_id"))
    if UUID_RE.fullmatch(session_id) is None:
        return None

    state_agent_pid = as_int(state.get("agent_pid"))
    state_agent_start_time = as_int(state.get("agent_start_time"))
    if state_agent_pid > 0 and (
        state_agent_pid != agent_pid
        or (
            state_agent_start_time > 0
            and state_agent_start_time != agent_start_time
        )
    ):
        return None

    title = thread_name_for_session(session_id) or shorten(state.get("title"))
    return (shorten(title), session_id) if title else None


def watcher_observation(
    socket: str,
    pane: str,
    *,
    agent_pid: int,
    agent_start_time: int,
    context: dict[str, Any] | None = None,
    verify_bound_session: bool = False,
) -> tuple[str, str]:
    """Use the index after binding, rechecking identity only when requested."""

    indexed = bound_session_observation(
        socket,
        pane,
        agent_pid=agent_pid,
        agent_start_time=agent_start_time,
        context=context,
    )
    if indexed is None:
        return pane_codex_status(socket, pane)
    if not verify_bound_session:
        return indexed
    captured = pane_codex_status(socket, pane)
    captured_session = clean(captured[1])
    if UUID_RE.fullmatch(captured_session) and captured_session != indexed[1]:
        return captured
    return indexed


def agent_state_stamp(kind: str, agent_pid: int, transcript: str = "") -> tuple[Any, ...]:
    """Return a change token for the state that names one live agent session."""

    if kind == AGENT_CLAUDE:
        return (
            file_stamp(CLAUDE_SESSIONS_ROOT / f"{agent_pid}.json"),
            file_stamp(Path(transcript)) if transcript else (0, 0),
        )
    return session_index_stamp()


def _newest_agent_process(socket: str, pane: str) -> dict[str, Any] | None:
    processes = agent_processes_for_target(socket, pane)
    if not processes:
        return None
    return max(
        processes,
        key=lambda process: (
            as_int(process.get("agent_start_time")),
            as_int(process.get("agent_pid")),
        ),
    )


def watch_pane(socket: str, pane: str) -> int:
    """Follow one launched agent CLI until its process exits."""

    context = pane_context(pane, socket=socket)
    server_pid = as_int((context or {}).get("server_pid"))
    if server_pid <= 0:
        return 0
    lock_file = watcher_lock_path(socket, server_pid, pane)
    lock_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tracked: dict[str, Any] | None = None
    window = clean((context or {}).get("window_id"))
    registration = watcher_state_path(socket, server_pid, pane)
    unavailable_since: float | None = None
    stop_reason = "unknown"
    agent_kind = AGENT_CODEX
    agent_transcript = ""
    last_state_stamp: tuple[Any, ...] | None = None

    with lock_file.open("a+", encoding="utf-8") as stream:
        os.chmod(lock_file, 0o600)
        try:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        atomic_write_json(
            registration,
            {
                "version": WATCHER_VERSION,
                "pid": os.getpid(),
                "start_time": process_start_time(os.getpid()),
                "socket": socket,
                "server_pid": server_pid,
                "pane": pane,
            },
        )
        deadline = time.monotonic() + WATCH_START_GRACE_SECONDS
        last_observation: tuple[str, str] | None = None
        last_reconcile_check = 0.0
        try:
            while True:
                context = pane_context(pane, socket=socket)
                if context is None:
                    now = time.monotonic()
                    unavailable_since = unavailable_since or now
                    if now - unavailable_since >= WATCH_CONTEXT_GRACE_SECONDS:
                        stop_reason = "pane-unavailable"
                        break
                    time.sleep(WATCH_INTERVAL_SECONDS)
                    continue
                unavailable_since = None
                if context["pane_dead"]:
                    stop_reason = "pane-dead"
                    break
                if as_int(context.get("server_pid")) != server_pid:
                    stop_reason = "server-changed"
                    break
                window = clean(context.get("window_id")) or window
                if tracked is None:
                    tracked = _newest_agent_process(socket, pane)
                    if tracked is None:
                        if time.monotonic() >= deadline:
                            stop_reason = "no-agent-process"
                            break
                        time.sleep(WATCH_INTERVAL_SECONDS)
                        continue
                    agent_kind = clean(tracked.get("agent_kind")) or AGENT_CODEX
                    if agent_kind == AGENT_CODEX:
                        stop_reason = "codex-listener-authoritative"
                        break
                    transcripts = [
                        str(item) for item in tracked.get("transcripts", [])
                    ]
                    agent_transcript = transcripts[0] if transcripts else ""
                agent_pid = as_int(tracked.get("agent_pid"))
                agent_start_time = as_int(tracked.get("agent_start_time"))
                if not process_is_alive(agent_pid, agent_start_time):
                    stop_reason = "process-exited"
                    break
                current_stamp = agent_state_stamp(
                    agent_kind, agent_pid, agent_transcript
                )
                stamp_changed = current_stamp != last_state_stamp
                last_state_stamp = current_stamp
                if agent_kind == AGENT_CLAUDE:
                    # Claude Code draws no parsable status line. Its session
                    # state file and transcript are authoritative and cheap to
                    # stat, so re-read them only after one of them changes.
                    observation = (
                        claude_observation(agent_pid, agent_transcript)
                        if stamp_changed or last_observation is None
                        else last_observation
                    )
                else:
                    observation = watcher_observation(
                        socket,
                        pane,
                        agent_pid=agent_pid,
                        agent_start_time=agent_start_time,
                        context=context,
                        verify_bound_session=stamp_changed,
                    )
                now = time.monotonic()
                if observation[0] and (
                    observation != last_observation
                    or now - last_reconcile_check
                    >= WATCH_RECONCILE_INTERVAL_SECONDS
                ):
                    apply_pane_observation(
                        socket,
                        pane,
                        *observation,
                        agent_pid=agent_pid,
                        agent_start_time=agent_start_time,
                        window=window,
                        agent_kind=agent_kind,
                    )
                    last_observation = observation
                    last_reconcile_check = now
                time.sleep(WATCH_INTERVAL_SECONDS)
        finally:
            registered = read_json(registration)
            if registered and as_int(registered.get("pid")) == os.getpid():
                _delete_state(registration)

    log(
        f"watcher stopped socket={socket!r} pane={pane} "
        f"reason={stop_reason}"
    )
    if (
        tracked is not None
        and stop_reason in {"pane-dead", "process-exited"}
        and current_server_pid(socket) == server_pid
    ):
        state = read_json(pane_state_path(socket, server_pid, pane))
        if state and (
            as_int(state.get("agent_pid")) == as_int(tracked.get("agent_pid"))
            and as_int(state.get("agent_start_time"))
            == as_int(tracked.get("agent_start_time"))
        ):
            cached_window = clear_pane_state(socket, pane)
            if window or cached_window:
                reconcile_window_from_cache(socket, window or cached_window)
    return 0


def ensure_pane_watcher(socket: str, pane: str) -> bool:
    """Start a detached same-pane observer unless one is already alive."""

    if session_registry_active():
        return False

    context = pane_context(pane, socket=socket)
    server_pid = as_int((context or {}).get("server_pid"))
    if server_pid <= 0:
        return False
    registered = read_json(watcher_state_path(socket, server_pid, pane))
    if registered and process_is_alive(
        as_int(registered.get("pid")),
        as_int(registered.get("start_time")),
    ):
        if as_int(registered.get("version"), 0) >= WATCHER_VERSION:
            return False
        watcher_pid = as_int(registered.get("pid"))
        try:
            os.kill(watcher_pid, signal.SIGTERM)
        except OSError:
            return False
        deadline = time.monotonic() + 1.0
        while process_is_alive(
            watcher_pid,
            as_int(registered.get("start_time")),
        ):
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.02)
    try:
        subprocess.Popen(
            [
                sys.executable,
                str(Path(__file__).resolve()),
                "--socket",
                socket,
                "--pane",
                pane,
                "--watch-pane",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
        )
    except OSError:
        return False
    return True


def ensure_window_watcher(socket: str, window: str) -> bool:
    """Backfill an observer for the active Claude pane in one window."""

    pane = window_active_pane(window, socket)
    process = _newest_agent_process(socket, pane) if pane else None
    if process is None or clean(process.get("agent_kind")) != AGENT_CLAUDE:
        return False
    return ensure_pane_watcher(socket, pane)


def discover_pane_state(socket: str, pane: str) -> dict[str, Any] | None:
    processes = [
        process
        for process in agent_processes_for_target(socket, pane)
        if clean(process.get("agent_kind")) == AGENT_CLAUDE
    ]
    if not processes:
        return None
    newest = max(
        processes,
        key=lambda process: (
            as_int(process.get("agent_start_time")),
            as_int(process.get("agent_pid")),
        ),
    )
    title, session_id = derive_process_title(newest)
    if not cache_pane_title(
        socket,
        pane,
        title,
        session_id,
        agent_pid=as_int(newest.get("agent_pid")),
        agent_start_time=as_int(newest.get("agent_start_time")),
    ):
        return None
    return cached_pane_state(socket, pane)


def _read_window_state(socket: str, server_pid: int, window: str) -> dict[str, Any] | None:
    payload = read_json(window_state_path(socket, server_pid, window))
    if payload is None:
        return None
    if (
        payload.get("socket") != socket
        or payload.get("window_id") != window
        or as_int(payload.get("server_pid")) != server_pid
    ):
        return None
    return payload


def _apply_window_state(
    socket: str,
    server_pid: int,
    window: str,
    pane: str,
    title: str,
) -> bool:
    path = window_state_path(socket, server_pid, window)
    state = _read_window_state(socket, server_pid, window)
    current_name = window_name(window, socket)
    if not current_name:
        return False
    if state is None:
        state = {
            "version": 2,
            "socket": socket,
            "server_pid": server_pid,
            "window_id": window,
            "original_name": current_name,
            "original_automatic_rename": window_automatic_rename(window, socket),
        }
    else:
        last_applied = clean(state.get("last_applied"))
        if (
            current_name not in {last_applied, shorten(title)}
            and current_name not in GENERIC_WINDOW_TITLES
        ):
            state["original_name"] = current_name

    if not rename_window(window, title, socket):
        return False
    set_window_automatic_rename(window, False, socket)
    state.update(
        {
            "owner_pane": pane,
            "last_applied": shorten(title),
            "updated_at_ns": time.time_ns(),
        }
    )
    try:
        atomic_write_json(path, state)
    except OSError:
        return False
    return True


def _restore_window_state(socket: str, server_pid: int, window: str) -> bool:
    path = window_state_path(socket, server_pid, window)
    state = _read_window_state(socket, server_pid, window)
    if state is None:
        _delete_state(path)
        return False
    current_name = window_name(window, socket)
    if not current_name:
        _delete_state(path)
        return False
    last_applied = clean(state.get("last_applied"))
    if current_name == last_applied:
        original_name = clean(state.get("original_name"))
        if original_name:
            rename_window(window, original_name, socket)
        set_window_automatic_rename(
            window,
            bool(state.get("original_automatic_rename")),
            socket,
        )
        log(f"restored socket={socket!r} window={window}")
    else:
        log(
            f"preserved user rename socket={socket!r} window={window} "
            f"current={current_name!r}"
        )
    _delete_state(path)
    return True


def _reconcile_window(socket: str, window: str, *, allow_discovery: bool) -> int:
    socket = clean(socket)
    window = clean(window)
    server_pid = current_server_pid(socket)
    if not socket or not window or server_pid <= 0:
        return 0
    with window_lock(socket, server_pid, window):
        active_pane = window_active_pane(window, socket)
        if not active_pane:
            _delete_state(window_state_path(socket, server_pid, window))
            return 0
        state = cached_pane_state(socket, active_pane)
        if state is None and allow_discovery:
            state = discover_pane_state(socket, active_pane)
        if state is None:
            return int(_restore_window_state(socket, server_pid, window))
        return int(
            _apply_window_state(
                socket,
                server_pid,
                window,
                active_pane,
                shorten(state.get("title")),
            )
        )


def reconcile_window(socket: str, window: str) -> int:
    return _reconcile_window(
        socket,
        window,
        allow_discovery=not session_registry_active(),
    )


def reconcile_window_from_cache(socket: str, window: str) -> int:
    return _reconcile_window(socket, window, allow_discovery=False)


def clear_pane_state(socket: str, pane: str) -> str:
    server_pid = current_server_pid(socket)
    if server_pid <= 0:
        return ""
    path = pane_state_path(socket, server_pid, pane)
    payload = read_json(path) or {}
    _delete_state(path)
    return clean(payload.get("window_id"))


def mark_pane_starting(socket: str, pane: str, title: str = "codex") -> int:
    """Apply a provisional title before the agent session lifecycle exists."""

    context = pane_context(pane, socket=socket)
    window = clean((context or {}).get("window_id"))
    if not window or not cache_pane_title(
        socket,
        pane,
        shorten(title or "codex"),
        provisional=True,
    ):
        return 0
    return reconcile_window(socket, window)


def finish_pane_starting(socket: str, pane: str) -> int:
    """Clear only a provisional launch title when the owning shell returns."""

    context = pane_context(pane, socket=socket)
    window = clean((context or {}).get("window_id"))
    if not window:
        return 0
    state = cached_pane_state(socket, pane)
    if state is None or not bool(state.get("provisional")):
        return 0
    clear_pane_state(socket, pane)
    return reconcile_window_from_cache(socket, window)


def clear_session_state(session_id: str) -> int:
    session_id = clean(session_id)
    if not session_id:
        return 0
    targets: set[tuple[str, str]] = set()
    for path in STATE_ROOT.glob("servers/*/panes/*.json"):
        payload = read_json(path)
        if payload and clean(payload.get("session_id")) == session_id:
            targets.add((clean(payload.get("socket")), clean(payload.get("window_id"))))
            _delete_state(path)
    return sum(reconcile_window(socket, window) for socket, window in targets if socket and window)


def remove_window_state(socket: str, window: str) -> None:
    server_pid = current_server_pid(socket)
    if server_pid > 0:
        _delete_state(window_state_path(socket, server_pid, window))


def cleanup_server(socket: str) -> int:
    server_pid = current_server_pid(socket)
    if server_pid <= 0:
        return 0
    root = _server_root(socket, server_pid)
    restored = 0
    for path in list((root / "windows").glob("*.json")):
        payload = read_json(path) or {}
        window = clean(payload.get("window_id"))
        if window:
            with window_lock(socket, server_pid, window):
                restored += int(_restore_window_state(socket, server_pid, window))
    shutil.rmtree(root, ignore_errors=True)
    return restored


def sync_all(socket: str) -> int:
    windows = tmux("list-windows", "-a", "-F", "#{window_id}", socket=socket)
    reconciled = 0
    for window in windows.splitlines():
        if not window:
            continue
        reconciled += reconcile_window(socket, window)
        ensure_window_watcher(socket, window)
    return reconciled


def sync_session_registry(
    path: Path = SESSION_REGISTRY_PATH,
    *,
    window_filter: tuple[str, str] | None = None,
) -> int:
    """Apply the listener registry without scanning Codex processes or screens."""

    registry = read_session_registry(path)
    if registry is None:
        return 0
    desired: set[tuple[str, int, str]] = set()
    targets: set[tuple[str, str]] = set()
    moved_windows: set[tuple[tuple[str, str], tuple[str, str]]] = set()
    connections = registry.get("connections", {})
    for connection in connections.values():
        if not isinstance(connection, dict):
            continue
        tmux_state = connection.get("tmux")
        thread = connection.get("thread")
        client = connection.get("client")
        if not all(isinstance(item, dict) for item in (tmux_state, thread, client)):
            continue
        socket = clean(tmux_state.get("socket"))
        pane = clean(tmux_state.get("pane"))
        server_pid = as_int(tmux_state.get("server_pid"))
        pane_pid = as_int(tmux_state.get("pane_pid"))
        thread_id = clean(thread.get("id"))
        if not socket.startswith("/") or not pane.startswith("%") or not thread_id:
            continue
        if current_server_pid(socket) != server_pid:
            continue
        context = pane_context(pane, socket=socket)
        if (
            context is None
            or context.get("pane_dead")
            or as_int(context.get("server_pid")) != server_pid
            or as_int(context.get("pane_pid")) != pane_pid
        ):
            continue
        client_pid = as_int(client.get("pid"))
        client_start = as_int(client.get("start_ticks"))
        if not process_is_alive(client_pid, client_start):
            continue
        title = shorten(thread.get("name")) or shorten(
            f"codex-{thread_id.split('-', 1)[0][:8]}"
        )
        previous = read_json(pane_state_path(socket, server_pid, pane)) or {}
        previous_window = ""
        if (
            clean(previous.get("source")) == SESSION_REGISTRY_SOURCE
            and clean(previous.get("socket")) == socket
            and as_int(previous.get("server_pid")) == server_pid
            and clean(previous.get("pane")) == pane
            and as_int(previous.get("pane_pid")) == pane_pid
        ):
            previous_window = clean(previous.get("window_id"))
        if not cache_pane_title(
            socket,
            pane,
            title,
            thread_id,
            agent_pid=client_pid,
            agent_start_time=client_start,
            source=SESSION_REGISTRY_SOURCE,
        ):
            continue
        desired.add((socket, server_pid, pane))
        window = clean(context.get("window_id"))
        if window:
            targets.add((socket, window))
            if previous_window and previous_window != window:
                previous_target = (socket, previous_window)
                current_target = (socket, window)
                targets.add(previous_target)
                moved_windows.add((previous_target, current_target))

    for pane_path in STATE_ROOT.glob("servers/*/panes/*.json"):
        cached = read_json(pane_path)
        if not cached or clean(cached.get("source")) != SESSION_REGISTRY_SOURCE:
            continue
        key = (
            clean(cached.get("socket")),
            as_int(cached.get("server_pid")),
            clean(cached.get("pane")),
        )
        if key in desired:
            continue
        window = clean(cached.get("window_id"))
        _delete_state(pane_path)
        if key[0] and window:
            targets.add((key[0], window))

    if window_filter is not None:
        related = {window_filter}
        for previous_target, current_target in moved_windows:
            if window_filter in (previous_target, current_target):
                related.update((previous_target, current_target))
        targets &= related
    return sum(
        reconcile_window_from_cache(socket, window)
        for socket, window in sorted(targets)
    )


def read_hook_payload() -> dict[str, Any] | None:
    if sys.stdin.isatty():
        return None
    try:
        raw = sys.stdin.read()
    except OSError:
        return None
    if not raw.strip():
        return None
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        log(f"ignored invalid hook JSON: {exc}")
        return None
    if not isinstance(payload, dict):
        log("ignored hook input that was not a JSON object")
        return None
    return payload


def sync_hook(payload: dict[str, Any]) -> int:
    if session_registry_active():
        return sync_session_registry()
    event = clean(payload.get("hook_event_name"))
    session_id = clean(payload.get("session_id"))
    target = resolve_hook_target_details(payload, os.environ)
    if target.get("ambiguous"):
        log(f"ambiguous hook target event={event or '-'} session={session_id or '-'}")
        return 0
    kind = hook_agent_kind(payload, target)
    if kind == AGENT_CODEX:
        log(
            f"ignored Codex hook without listener registry "
            f"event={event or '-'} session={session_id or '-'}"
        )
        return 0
    socket = clean(target.get("socket"))
    pane = clean(target.get("pane"))
    if not socket or not pane:
        if event == "SessionEnd" and session_id:
            return clear_session_state(session_id)
        log(f"could not route hook event={event or '-'} session={session_id or '-'}")
        return 0

    context = pane_context(pane, socket=socket)
    window = clean((context or {}).get("window_id"))
    if event == "SessionEnd":
        cached_window = clear_pane_state(socket, pane)
        return reconcile_window(socket, window or cached_window) if window or cached_window else 0

    title, session_id = title_for_hook(
        payload, kind, as_int(target.get("agent_pid"))
    )
    if not title:
        return 0
    if not cache_pane_title(
        socket,
        pane,
        title,
        session_id,
        agent_pid=as_int(target.get("agent_pid")),
        agent_start_time=as_int(target.get("agent_start_time")),
    ):
        return 0
    return reconcile_window(socket, window) if window else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    parser.add_argument("--pane")
    parser.add_argument("--window", nargs="?")
    parser.add_argument("--socket")
    parser.add_argument(
        "--starting",
        action="store_true",
        help="apply a provisional title before a new Codex session exists",
    )
    parser.add_argument(
        "--shell-ready",
        action="store_true",
        help="clear a provisional title after the launching shell returns",
    )
    parser.add_argument("--watch-pane", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--ensure-watcher", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--registry-sync", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument(
        "--registry-file", type=Path, default=SESSION_REGISTRY_PATH, help=argparse.SUPPRESS
    )
    parser.add_argument("--title", default="codex", help=argparse.SUPPRESS)
    parser.add_argument("--all", action="store_true", help="reconcile all windows on one server")
    parser.add_argument("--pane-exited", action="store_true")
    parser.add_argument("--window-closed", action="store_true")
    parser.add_argument("--cleanup", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.registry_sync:
        sync_session_registry(args.registry_file)
        return 0
    payload = read_hook_payload()
    if payload is not None:
        sync_hook(payload)
        return 0

    socket = clean(args.socket or tmux_socket_from_env(os.environ))
    if args.watch_pane and socket and args.pane:
        return watch_pane(socket, args.pane)
    if args.ensure_watcher and socket and args.pane:
        ensure_pane_watcher(socket, args.pane)
    if args.starting and socket and args.pane:
        mark_pane_starting(socket, args.pane, args.title)
        ensure_pane_watcher(socket, args.pane)
    elif args.shell_ready and socket and args.pane:
        finish_pane_starting(socket, args.pane)
    elif args.cleanup and socket:
        cleanup_server(socket)
    elif args.window_closed and socket and args.window:
        remove_window_state(socket, args.window)
    elif args.pane_exited and socket and args.pane:
        cached_window = clear_pane_state(socket, args.pane)
        window = clean(args.window or cached_window)
        if window:
            reconcile_window(socket, window)
    elif args.window and socket:
        if session_registry_active(args.registry_file):
            sync_session_registry(args.registry_file, window_filter=(socket, clean(args.window)))
        else:
            reconcile_window(socket, args.window)
        ensure_window_watcher(socket, args.window)
    elif args.pane and socket:
        context = pane_context(args.pane, socket=socket)
        if context and context["window_id"]:
            reconcile_window(socket, context["window_id"])
            if _newest_agent_process(socket, args.pane) is not None:
                ensure_pane_watcher(socket, args.pane)
    elif args.all and socket:
        if session_registry_active(args.registry_file):
            sync_session_registry(args.registry_file)
        else:
            sync_all(socket)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
