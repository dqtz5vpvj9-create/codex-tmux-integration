{
  "name": "title-sync",
  "description": "Keep a tmux window title aligned with its Codex or Claude session.",
  "dependencies": ["tmux-context"],
  "binaries": [
    {"source": "bin/codex-tmux-title-sync", "name": "codex-tmux-title-sync"}
  ],
  "tmux": ["tmux/title-sync.conf"],
  "shell": ["shell/codex-title.zsh"],
  "hooks": {
    "codex": [],
    "claude": ["hooks/claude.json"]
  }
}
