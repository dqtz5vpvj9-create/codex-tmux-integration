{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=title-sync {{BIN_DIR}}/codex-tmux-title-sync",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=title-sync {{BIN_DIR}}/codex-tmux-title-sync",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=title-sync {{BIN_DIR}}/codex-tmux-title-sync",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_TMUX_INTEGRATION=title-sync {{BIN_DIR}}/codex-tmux-title-sync",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
