{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{BIN_DIR}}/agent-tmux-notify",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{BIN_DIR}}/agent-tmux-notify",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
