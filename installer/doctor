#!/usr/bin/env python3
"""Audit installed files, hook ownership, and live tmux runtime state."""

from __future__ import annotations

import importlib.util
import json
import os
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

from merge_hooks import command_executable  # noqa: E402

STATE_SCHEMA = 2
MANAGED_EXECUTABLES = {
    "agent-tmux-notify",
    "claude-tmux-notify-wrapper",
    "codex-tmux-notify-wrapper",
    "codex-tmux-title-sync",
}
TMUX_HOOK_COUNTS = {
    "title-sync": 4,
    "window-attention": 4,
    "pane-logging": 3,
}


def result(label: str, ok: bool, detail: str = "") -> None:
    suffix = f" - {detail}" if detail else ""
    print(f"{'PASS' if ok else 'FAIL'} {label}{suffix}")


def warning(label: str, detail: str = "") -> None:
    suffix = f" - {detail}" if detail else ""
    print(f"WARN {label}{suffix}")


def load_runtime(repo_root: Path):
    path = repo_root / "shared/tmux-runtime/tmux_runtime.py"
    spec = importlib.util.spec_from_file_location("codex_tmux_runtime_doctor", path)
    if spec is None or spec.loader is None:
        return None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def sha256(path: Path) -> str:
    import hashlib

    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def run(command: list[str], home: Path, timeout: float = 5):
    env = os.environ.copy()
    env["HOME"] = str(home)
    try:
        return subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
            env=env,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def main() -> int:
    home = Path(os.environ.get("CODEX_TMUX_HOME", Path.home())).expanduser().resolve()
    state_path = home / ".local/state/codex-tmux-integration/state.json"
    errors = 0
    warnings = 0

    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
        if not isinstance(state, dict):
            raise TypeError("state is not an object")
        result("state manifest", True, str(state_path))
    except (OSError, json.JSONDecodeError, TypeError) as exc:
        result("state manifest", False, str(exc))
        return 1

    schema_ok = state.get("schema") == STATE_SCHEMA
    result("state schema", schema_ok, str(state.get("schema", "missing")))
    errors += not schema_ok

    repo_root = Path(state.get("repo_root", ""))
    enabled = list(state.get("enabled_features", []))
    result("repository", repo_root.is_dir(), str(repo_root))
    errors += not repo_root.is_dir()

    for feature in enabled:
        manifest = repo_root / "features" / feature / "feature.json"
        ok = manifest.is_file()
        result(f"feature {feature}", ok, str(manifest))
        errors += not ok

    for target_text, source_text in state.get("links", {}).items():
        target = Path(target_text)
        source = Path(source_text)
        ok = target.is_symlink() and target.resolve() == source.resolve()
        result(f"link {target.name}", ok, f"{target} -> {source}")
        errors += not ok

    for path_text, expected_hash in state.get("config", {}).items():
        path = Path(path_text)
        try:
            actual_hash = sha256(path)
            ok = actual_hash == expected_hash
        except OSError:
            ok = False
        result(f"config hash {path.name}", ok, str(path))
        errors += not ok

    tmux_features = [feature for feature in enabled if feature in TMUX_HOOK_COUNTS]
    shell_enabled = "ssh-autoattach" in enabled
    tmux_main = home / ".tmux.conf"
    zsh_main = home / ".zshrc"
    for label, path, expected in (
        ("tmux managed block", tmux_main, bool(tmux_features)),
        ("zsh managed block", zsh_main, shell_enabled),
    ):
        try:
            present = "# >>> codex-tmux-integration >>>" in path.read_text(encoding="utf-8")
        except OSError:
            present = False
        ok = present == expected
        result(label, ok, str(path))
        errors += not ok

    for label, path in (
        ("Codex hooks JSON", home / ".codex/hooks.json"),
        ("Claude settings JSON", home / ".claude/settings.json"),
    ):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            hooks = data.get("hooks", {})
            ok = isinstance(hooks, dict)
            if ok:
                for groups in hooks.values():
                    if not isinstance(groups, list):
                        continue
                    for group in groups:
                        for hook in group.get("hooks", []) if isinstance(group, dict) else []:
                            command = hook.get("command", "") if isinstance(hook, dict) else ""
                            executable = command_executable(command)
                            if Path(executable).name in MANAGED_EXECUTABLES:
                                ok = ok and Path(executable).is_file()
        except (OSError, json.JSONDecodeError, TypeError):
            ok = False
        result(label, ok, str(path))
        errors += not ok

    if shell_enabled:
        zsh = shutil.which("zsh")
        shell_config = home / ".config/codex-tmux-integration/shell.zsh"
        check = run([zsh, "-n", str(shell_config)], home) if zsh else None
        ok = check is not None and check.returncode == 0
        detail = check.stderr.strip() if check and check.stderr.strip() else str(shell_config)
        result("zsh syntax", ok, detail)
        errors += not ok

    tmux = shutil.which("tmux")
    tmux_config = home / ".config/codex-tmux-integration/tmux.conf"
    if tmux_features:
        if tmux and tmux_config.exists():
            label = f"codex-tmux-doctor-{uuid.uuid4().hex[:10]}"
            check = run(
                [tmux, "-L", label, "-f", str(tmux_config), "new-session", "-d", "-s", "doctor"],
                home,
            )
            run([tmux, "-L", label, "kill-server"], home)
            ok = check is not None and check.returncode == 0
            detail = check.stderr.strip() if check and check.stderr.strip() else str(tmux_config)
        else:
            ok = False
            detail = "tmux or generated tmux config missing"
        result("isolated tmux config", ok, detail)
        errors += not ok

    runtime = load_runtime(repo_root) if repo_root.is_dir() else None
    live = runtime.live_sockets(home) if runtime and tmux else []
    manager = home / ".local/bin/codex-tmux-hook-manager"
    for socket in live:
        for feature in tmux_features:
            check = run(
                [sys.executable, str(manager), "list-owned", feature, "--socket", socket],
                home,
            )
            count = len(check.stdout.splitlines()) if check and check.returncode == 0 else 0
            expected = TMUX_HOOK_COUNTS[feature]
            ok = count == expected
            result(f"live hooks {feature}", ok, f"{socket}: {count}/{expected}")
            errors += not ok
        if "pane-logging" in enabled:
            panes = run(
                [
                    tmux,
                    "-S",
                    socket,
                    "list-panes",
                    "-a",
                    "-F",
                    "#{pane_id}\t#{@codex_tmux_pipe}",
                ],
                home,
            )
            missing = []
            if panes and panes.returncode == 0:
                for line in panes.stdout.splitlines():
                    pane, _, marker = line.partition("\t")
                    if not marker:
                        missing.append(pane)
            if missing:
                warning("pane logging ownership", f"{socket}: {len(missing)} panes use no managed pipe")
                warnings += 1

    if "external-notifications" in enabled:
        config = home / ".config/codex-tmux-integration/notifications.env"
        configured = config.is_file() or bool(os.environ.get("ANDROIDTOOLS_NOTIFY_QUEUE"))
        if configured:
            result("optional notification backend", True, str(config))
        else:
            warning("optional notification backend", "no local backend configured")
            warnings += 1

    print(f"INFO live tmux servers - {len(live)}")
    print(f"SUMMARY errors={errors} warnings={warnings}")
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
