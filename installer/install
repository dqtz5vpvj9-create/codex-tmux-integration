#!/usr/bin/env python3
"""Install selected codex-tmux-integration features idempotently."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from merge_hooks import apply_fragments, atomic_write_json, hooks_diff, load_json


MANAGED_BEGIN = "# >>> codex-tmux-integration >>>"
MANAGED_END = "# <<< codex-tmux-integration <<<"
ALL_FEATURES = (
    "title-sync",
    "window-attention",
    "pane-logging",
    "ssh-autoattach",
    "external-notifications",
)
LEGACY_TMUX_PATTERNS = (
    "codex-tmux-title-sync",
    "Claude/Codex hooks own tmux window names",
    "automatic-rename off",
    "allow-set-title off",
    "automatic-rename-format",
    "Clear per-window highlight (set by agent-tmux-notify)",
    "after-select-window[60]",
    "after-select-pane[60]",
    "client-attached[60]",
    "client-focus-in[60]",
    "Auto-enable pipe-pane logging on every pane",
    "session-created[70]",
    "after-new-window[70]",
    "after-split-window[70]",
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "--features",
        help="comma-separated feature names; defaults to every feature",
    )
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument(
        "--repo-root", type=Path, default=Path(__file__).resolve().parents[1]
    )
    parser.add_argument("--notification-queue", type=Path)
    parser.add_argument("--notification-python", type=Path)
    return parser.parse_args()


def atomic_write_text(path: Path, text: str, mode: int | None = None) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if mode is None:
        mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def load_manifest(repo_root: Path, name: str) -> tuple[Path, dict[str, Any]]:
    feature_root = repo_root / "features" / name
    manifest_path = feature_root / "feature.json"
    if not manifest_path.is_file():
        raise ValueError(f"unknown feature: {name}")
    manifest = load_json(manifest_path)
    if manifest.get("name") != name:
        raise ValueError(f"{manifest_path}: feature name mismatch")
    return feature_root, manifest


def selected_features(value: str | None) -> list[str]:
    names = list(ALL_FEATURES) if value is None else [
        item.strip() for item in value.split(",") if item.strip()
    ]
    unknown = sorted(set(names) - set(ALL_FEATURES))
    if unknown:
        raise ValueError(f"unknown features: {', '.join(unknown)}")
    return [name for name in ALL_FEATURES if name in names]


def strip_managed_block(text: str) -> str:
    pattern = re.compile(
        rf"\n?{re.escape(MANAGED_BEGIN)}.*?{re.escape(MANAGED_END)}\n?",
        re.DOTALL,
    )
    return pattern.sub("\n", text).rstrip() + "\n"


def install_managed_block(text: str, body: str) -> str:
    clean = strip_managed_block(text)
    block = f"{MANAGED_BEGIN}\n{body.rstrip()}\n{MANAGED_END}\n"
    return clean.rstrip() + "\n\n" + block


def desired_tmux_main(current: str, config_path: Path) -> str:
    clean = strip_managed_block(current)
    lines = []
    for line in clean.splitlines():
        if any(pattern in line for pattern in LEGACY_TMUX_PATTERNS):
            continue
        lines.append(line)
    clean = "\n".join(lines).rstrip() + "\n"
    return install_managed_block(clean, f'source-file "{config_path}"')


def desired_zsh_main(current: str, shell_path: Path) -> str:
    clean = strip_managed_block(current)
    legacy = re.compile(
        r"\n?# SSH login: choose a tmux server/session, or select one through env vars\."
        r".*?\nfi\n(?=\n*cxc\(\))",
        re.DOTALL,
    )
    clean = legacy.sub("\n", clean)
    return install_managed_block(clean, f'source "{shell_path}"')


def desired_aggregators(
    manifests: list[tuple[Path, dict[str, Any]]]
) -> tuple[str, str]:
    tmux_lines = ["# Generated by codex-tmux-integration. Do not edit."]
    shell_lines = ["# Generated by codex-tmux-integration. Do not edit."]
    for feature_root, manifest in manifests:
        for relative in manifest.get("tmux", []):
            tmux_lines.append(f'source-file "{feature_root / relative}"')
        for relative in manifest.get("shell", []):
            shell_lines.append(f'source "{feature_root / relative}"')
    return "\n".join(tmux_lines) + "\n", "\n".join(shell_lines) + "\n"


def collect_fragments(
    manifests: list[tuple[Path, dict[str, Any]]], target: str
) -> list[dict[str, Any]]:
    fragments = []
    for feature_root, manifest in manifests:
        for relative in manifest.get("hooks", {}).get(target, []):
            fragments.append(load_json(feature_root / relative))
    return fragments


def desired_links(
    manifests: list[tuple[Path, dict[str, Any]]], bin_dir: Path
) -> dict[Path, Path]:
    links: dict[Path, Path] = {}
    for feature_root, manifest in manifests:
        for item in manifest.get("binaries", []):
            source = (feature_root / item["source"]).resolve()
            target = bin_dir / item["name"]
            links[target] = source
    return links


def add_shared_compatibility_links(
    links: dict[Path, Path],
    names: list[str],
    repo_root: Path,
    bin_dir: Path,
) -> dict[Path, Path]:
    result = dict(links)
    if {"title-sync", "window-attention"} & set(names):
        result[bin_dir / "agent_tmux_context.py"] = (
            repo_root / "shared/tmux-context/agent_tmux_context.py"
        ).resolve()
    return result


def link_matches(target: Path, source: Path) -> bool:
    return target.is_symlink() and target.resolve() == source.resolve()


def backup_paths(paths: list[Path], backup_root: Path, home: Path) -> None:
    for path in paths:
        if not path.exists() and not path.is_symlink():
            continue
        try:
            relative = path.relative_to(home)
        except ValueError:
            relative = Path("external") / path.as_posix().lstrip("/")
        destination = backup_root / relative
        destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if path.is_symlink():
            destination.symlink_to(os.readlink(path))
        elif path.is_file():
            shutil.copy2(path, destination)
            os.chmod(destination, 0o600)


def replace_link(target: Path, source: Path) -> None:
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = target.with_name(f".{target.name}.codex-tmux-{os.getpid()}")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(source)
    os.replace(temporary, target)


def main() -> int:
    args = parse_args()
    home = args.home.expanduser().resolve()
    repo_root = args.repo_root.expanduser().resolve()
    names = selected_features(args.features)
    manifests = [load_manifest(repo_root, name) for name in names]

    bin_dir = home / ".local" / "bin"
    config_root = home / ".config" / "codex-tmux-integration"
    state_root = home / ".local" / "state" / "codex-tmux-integration"
    tmux_aggregate = config_root / "tmux.conf"
    shell_aggregate = config_root / "shell.zsh"
    tmux_main = home / ".tmux.conf"
    zsh_main = home / ".zshrc"
    codex_hooks = home / ".codex" / "hooks.json"
    claude_settings = home / ".claude" / "settings.json"
    notification_config = config_root / "notifications.env"

    tmux_text, shell_text = desired_aggregators(manifests)
    current_tmux_main = tmux_main.read_text(encoding="utf-8") if tmux_main.exists() else ""
    current_zsh_main = zsh_main.read_text(encoding="utf-8") if zsh_main.exists() else ""
    wanted_tmux_main = desired_tmux_main(current_tmux_main, tmux_aggregate)
    wanted_zsh_main = desired_zsh_main(current_zsh_main, shell_aggregate)

    replacements = {"BIN_DIR": str(bin_dir), "REPO_ROOT": str(repo_root)}
    codex_before = load_json(codex_hooks)
    claude_before = load_json(claude_settings)
    codex_after = apply_fragments(
        codex_before, collect_fragments(manifests, "codex"), replacements
    )
    claude_after = apply_fragments(
        claude_before, collect_fragments(manifests, "claude"), replacements
    )
    links = add_shared_compatibility_links(
        desired_links(manifests, bin_dir), names, repo_root, bin_dir
    )
    notification_text = None
    if args.notification_queue or args.notification_python:
        notification_lines = [
            "# Generated locally by codex-tmux-integration. Do not commit."
        ]
        if args.notification_queue:
            notification_lines.append(
                "ANDROIDTOOLS_NOTIFY_QUEUE="
                + shlex.quote(str(args.notification_queue.expanduser().resolve()))
            )
        if args.notification_python:
            notification_lines.append(
                "ANDROIDTOOLS_NOTIFY_PYTHON="
                + shlex.quote(str(args.notification_python.expanduser().resolve()))
            )
        notification_text = "\n".join(notification_lines) + "\n"

    changes: list[str] = []
    for target, source in links.items():
        if not link_matches(target, source):
            changes.append(f"link {target} -> {source}")
    if not tmux_aggregate.exists() or tmux_aggregate.read_text(encoding="utf-8") != tmux_text:
        changes.append(f"write {tmux_aggregate}")
    if not shell_aggregate.exists() or shell_aggregate.read_text(encoding="utf-8") != shell_text:
        changes.append(f"write {shell_aggregate}")
    if current_tmux_main != wanted_tmux_main:
        changes.append(f"update {tmux_main}")
    if current_zsh_main != wanted_zsh_main:
        changes.append(f"update {zsh_main}")
    if codex_before != codex_after:
        changes.append(f"merge hooks in {codex_hooks}")
    if claude_before != claude_after:
        changes.append(f"merge hooks in {claude_settings}")
    if notification_text is not None and (
        not notification_config.exists()
        or notification_config.read_text(encoding="utf-8") != notification_text
    ):
        changes.append(f"write private notification config {notification_config}")

    if not changes:
        print(f"already up to date: {', '.join(names)}")
        return 0

    print("planned changes:")
    for change in changes:
        print(f"  - {change}")
    if codex_before != codex_after:
        print(hooks_diff(codex_before, codex_after, str(codex_hooks)))
    if claude_before != claude_after:
        print(hooks_diff(claude_before, claude_after, str(claude_settings)))
    if args.dry_run:
        return 0

    stamp = datetime.now(timezone.utc).astimezone().strftime("%Y%m%dT%H%M%S%z")
    backup_root = state_root / "backups" / stamp
    backup_root.mkdir(mode=0o700, parents=True, exist_ok=False)
    backup_paths(
        [
            tmux_main,
            zsh_main,
            codex_hooks,
            claude_settings,
            tmux_aggregate,
            shell_aggregate,
            notification_config,
            *links.keys(),
        ],
        backup_root,
        home,
    )

    for target, source in links.items():
        replace_link(target, source)
    atomic_write_text(tmux_aggregate, tmux_text)
    atomic_write_text(shell_aggregate, shell_text)
    atomic_write_text(tmux_main, wanted_tmux_main)
    atomic_write_text(zsh_main, wanted_zsh_main)
    atomic_write_json(codex_hooks, codex_after)
    atomic_write_json(claude_settings, claude_after)
    if notification_text is not None:
        atomic_write_text(notification_config, notification_text, mode=0o600)

    state = {
        "repo_root": str(repo_root),
        "enabled_features": names,
        "backup_root": str(backup_root),
        "installed_at": stamp,
        "links": {str(target): str(source) for target, source in links.items()},
        "config": {
            str(tmux_aggregate): sha256(tmux_aggregate),
            str(shell_aggregate): sha256(shell_aggregate),
        },
    }
    if notification_config.exists():
        state["config"][str(notification_config)] = sha256(notification_config)
    atomic_write_json(state_root / "state.json", state)
    print(f"installed: {', '.join(names)}")
    print(f"backup: {backup_root}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
