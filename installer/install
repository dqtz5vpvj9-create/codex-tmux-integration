#!/usr/bin/env python3
"""Install selected codex-tmux-integration features and reconcile live tmux state."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from merge_hooks import apply_fragments, atomic_write_json, hooks_diff, load_json

MANAGED_BEGIN = "# >>> codex-tmux-integration >>>"
MANAGED_END = "# <<< codex-tmux-integration <<<"
STATE_SCHEMA = 2
ALL_FEATURES = (
    "title-sync",
    "window-attention",
    "pane-logging",
    "ssh-autoattach",
)
TMUX_FEATURES = {"title-sync", "window-attention", "pane-logging"}
LEGACY_HOOKS = {
    "title-sync": {
        "pane-focus-in[50]": "codex-tmux-title-sync",
        "after-select-pane[50]": "codex-tmux-title-sync",
        "after-select-window[50]": "codex-tmux-title-sync",
    },
    "window-attention": {
        "after-select-window[60]": "window-status-style",
        "after-select-pane[60]": "window-status-style",
        "client-attached[60]": "window-status-style",
        "client-focus-in[60]": "window-status-style",
    },
    "pane-logging": {
        "session-created[70]": "tmux-autolog",
        "after-new-window[70]": "tmux-autolog",
        "after-split-window[70]": "tmux-autolog",
    },
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "--features",
        help="comma-separated feature names; defaults to every feature",
    )
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument(
        "--repo-root", type=Path, default=Path(__file__).resolve().parents[1]
    )
    return parser.parse_args()


def atomic_write_text(path: Path, text: str, mode: int | None = None) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if mode is None:
        mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def create_backup_root(state_root: Path, prefix: str = "") -> tuple[Path, str]:
    """Create a unique backup directory and return its display timestamp."""

    stamp = datetime.now(timezone.utc).astimezone().strftime("%Y%m%dT%H%M%S%z")
    backups = state_root / "backups"
    backups.mkdir(mode=0o700, parents=True, exist_ok=True)
    backup_root = Path(tempfile.mkdtemp(prefix=f"{prefix}{stamp}-", dir=backups))
    backup_root.chmod(0o700)
    return backup_root, stamp


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def load_manifest(repo_root: Path, name: str) -> tuple[Path, dict[str, Any]]:
    feature_root = repo_root / "features" / name
    manifest_path = feature_root / "feature.json"
    if not manifest_path.is_file():
        raise ValueError(f"unknown feature: {name}")
    manifest = load_json(manifest_path)
    if manifest.get("name") != name:
        raise ValueError(f"{manifest_path}: feature name mismatch")
    return feature_root, manifest


def selected_features(value: str | None) -> list[str]:
    names = list(ALL_FEATURES) if value is None else [
        item.strip() for item in value.split(",") if item.strip()
    ]
    unknown = sorted(set(names) - set(ALL_FEATURES))
    if unknown:
        raise ValueError(f"unknown features: {', '.join(unknown)}")
    return [name for name in ALL_FEATURES if name in names]


def strip_managed_block(text: str) -> str:
    pattern = re.compile(
        rf"\n?{re.escape(MANAGED_BEGIN)}.*?{re.escape(MANAGED_END)}\n?",
        re.DOTALL,
    )
    return pattern.sub("\n", text).rstrip() + "\n"


def install_managed_block(text: str, body: str) -> str:
    clean = strip_managed_block(text)
    block = f"{MANAGED_BEGIN}\n{body.rstrip()}\n{MANAGED_END}\n"
    return clean.rstrip() + "\n\n" + block


def desired_tmux_main(current: str, config_path: Path) -> str:
    return install_managed_block(current, f'source-file "{config_path}"')


def desired_zsh_main(current: str, shell_path: Path) -> str:
    return install_managed_block(current, f'source "{shell_path}"')


def desired_aggregators(
    manifests: list[tuple[Path, dict[str, Any]]]
) -> tuple[str, str]:
    tmux_lines = ["# Generated by codex-tmux-integration. Do not edit."]
    shell_lines = ["# Generated by codex-tmux-integration. Do not edit."]
    for feature_root, manifest in manifests:
        for relative in manifest.get("tmux", []):
            tmux_lines.append(f'source-file "{feature_root / relative}"')
        for relative in manifest.get("shell", []):
            shell_lines.append(f'source "{feature_root / relative}"')
    return "\n".join(tmux_lines) + "\n", "\n".join(shell_lines) + "\n"


def collect_fragments(
    manifests: list[tuple[Path, dict[str, Any]]], target: str
) -> list[dict[str, Any]]:
    fragments = []
    for feature_root, manifest in manifests:
        for relative in manifest.get("hooks", {}).get(target, []):
            fragments.append(load_json(feature_root / relative))
    return fragments


def desired_links(
    manifests: list[tuple[Path, dict[str, Any]]], bin_dir: Path
) -> dict[Path, Path]:
    links: dict[Path, Path] = {}
    for feature_root, manifest in manifests:
        for item in manifest.get("binaries", []):
            source = (feature_root / item["source"]).resolve()
            target = bin_dir / item["name"]
            if target in links and links[target] != source:
                raise ValueError(f"duplicate binary target: {target}")
            links[target] = source
    return links


def add_shared_compatibility_links(
    links: dict[Path, Path],
    names: list[str],
    repo_root: Path,
    bin_dir: Path,
) -> dict[Path, Path]:
    result = dict(links)
    if {"title-sync", "window-attention"} & set(names):
        result[bin_dir / "agent_tmux_context.py"] = (
            repo_root / "shared/tmux-context/agent_tmux_context.py"
        ).resolve()
    if TMUX_FEATURES & set(names):
        result[bin_dir / "codex-tmux-hook-manager"] = (
            repo_root / "shared/tmux-runtime/codex-tmux-hook-manager"
        ).resolve()
        result[bin_dir / "tmux_runtime.py"] = (
            repo_root / "shared/tmux-runtime/tmux_runtime.py"
        ).resolve()
    return result


def link_matches(target: Path, source: Path) -> bool:
    return target.is_symlink() and target.resolve() == source.resolve()


def backup_paths(paths: list[Path], backup_root: Path, home: Path) -> None:
    for path in paths:
        if not path.exists() and not path.is_symlink():
            continue
        try:
            relative = path.relative_to(home)
        except ValueError:
            relative = Path("external") / path.as_posix().lstrip("/")
        destination = backup_root / relative
        destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if path.is_symlink():
            destination.symlink_to(os.readlink(path))
        elif path.is_file():
            shutil.copy2(path, destination)
            os.chmod(destination, 0o600)


def replace_link(target: Path, source: Path) -> None:
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = target.with_name(f".{target.name}.codex-tmux-{os.getpid()}")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(source)
    os.replace(temporary, target)


def remove_recorded_link(target: Path, source: Path) -> bool:
    if target.is_symlink() and target.resolve() == source.resolve():
        target.unlink()
        return True
    return False


def load_runtime_module(repo_root: Path):
    path = repo_root / "shared/tmux-runtime/tmux_runtime.py"
    spec = importlib.util.spec_from_file_location("codex_tmux_runtime_installer", path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"could not load runtime module: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def run_command(
    command: list[str],
    *,
    home: Path,
    timeout: float = 5,
) -> subprocess.CompletedProcess[str] | None:
    env = os.environ.copy()
    env["HOME"] = str(home)
    try:
        return subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
            env=env,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def cleanup_feature_runtime(home: Path, bin_dir: Path, socket: str, feature: str) -> None:
    manager = bin_dir / "codex-tmux-hook-manager"
    if manager.exists():
        run_command(
            [sys.executable, str(manager), "remove", feature, "--socket", socket],
            home=home,
        )
    cleanup_commands = {
        "title-sync": [bin_dir / "codex-tmux-title-sync", "--cleanup", "--socket", socket],
        "window-attention": [bin_dir / "agent-tmux-notify", "--cleanup", "--socket", socket],
        "pane-logging": [bin_dir / "tmux-autolog", "--socket", socket, "cleanup"],
    }
    command = cleanup_commands.get(feature)
    if command and Path(command[0]).exists():
        run_command([str(item) for item in command], home=home)


def remove_legacy_hooks(home: Path, socket: str, features: list[str]) -> None:
    for feature in features:
        for target, marker in LEGACY_HOOKS.get(feature, {}).items():
            hook_name = target.split("[", 1)[0]
            shown = run_command(
                ["tmux", "-S", socket, "show-hooks", "-g", hook_name],
                home=home,
            )
            if shown is None or shown.returncode != 0:
                continue
            if any(line.startswith(target + " ") and marker in line for line in shown.stdout.splitlines()):
                run_command(
                    ["tmux", "-S", socket, "set-hook", "-gu", target],
                    home=home,
                )


def migrate_legacy_runtime(home: Path, socket: str, features: list[str]) -> None:
    remove_legacy_hooks(home, socket, features)
    if "title-sync" in features:
        for option in ("automatic-rename", "allow-set-title", "automatic-rename-format"):
            run_command(
                ["tmux", "-S", socket, "set-window-option", "-gu", option],
                home=home,
            )
    if "window-attention" in features:
        windows = run_command(
            [
                "tmux",
                "-S",
                socket,
                "list-windows",
                "-a",
                "-F",
                "#{window_id}\t#{window_status_style}",
            ],
            home=home,
        )
        if windows and windows.returncode == 0:
            for line in windows.stdout.splitlines():
                window, separator, style = line.partition("\t")
                if separator and style == "fg=black,bg=#d7af00,bold":
                    run_command(
                        [
                            "tmux",
                            "-S",
                            socket,
                            "set-window-option",
                            "-u",
                            "-t",
                            window,
                            "window-status-style",
                        ],
                        home=home,
                    )


def reconcile_runtime(
    *,
    home: Path,
    repo_root: Path,
    bin_dir: Path,
    tmux_aggregate: Path,
    names: list[str],
    removed: list[str],
    previous_features: list[str],
    migrate_legacy: bool,
) -> list[str]:
    runtime = load_runtime_module(repo_root)
    messages: list[str] = []
    for socket in runtime.live_sockets(home):
        if migrate_legacy:
            migrate_legacy_runtime(home, socket, previous_features)
            if "pane-logging" in previous_features and (bin_dir / "tmux-autolog").exists():
                run_command(
                    [str(bin_dir / "tmux-autolog"), "--socket", socket, "migrate"],
                    home=home,
                )
        for feature in removed:
            cleanup_feature_runtime(home, bin_dir, socket, feature)
        if TMUX_FEATURES & set(names):
            sourced = run_command(
                ["tmux", "-S", socket, "source-file", str(tmux_aggregate)],
                home=home,
            )
            if sourced is None or sourced.returncode != 0:
                detail = sourced.stderr.strip() if sourced else "tmux unavailable"
                messages.append(f"warning: could not source {socket}: {detail}")
                continue
            runtime.register_socket(socket, runtime.server_pid(socket), home)
            if "pane-logging" in names:
                run_command(
                    [str(bin_dir / "tmux-autolog"), "--socket", socket, "sweep"],
                    home=home,
                )
            if "title-sync" in names:
                run_command(
                    [str(bin_dir / "codex-tmux-title-sync"), "--socket", socket, "--all"],
                    home=home,
                )
        messages.append(f"reconciled live tmux socket: {socket}")
    if migrate_legacy:
        shutil.rmtree(home / ".cache/codex-tmux-title", ignore_errors=True)
    return messages


def main() -> int:
    args = parse_args()
    home = args.home.expanduser().resolve()
    repo_root = args.repo_root.expanduser().resolve()
    names = selected_features(args.features)
    manifests = [load_manifest(repo_root, name) for name in names]

    bin_dir = home / ".local" / "bin"
    config_root = home / ".config" / "codex-tmux-integration"
    state_root = home / ".local" / "state" / "codex-tmux-integration"
    state_path = state_root / "state.json"
    previous_state = load_json(state_path)
    previous_features = list(previous_state.get("enabled_features", []))
    previous_schema = int(previous_state.get("schema", 1)) if previous_state else STATE_SCHEMA
    removed = [name for name in previous_features if name not in names]

    tmux_aggregate = config_root / "tmux.conf"
    shell_aggregate = config_root / "shell.zsh"
    tmux_main = home / ".tmux.conf"
    zsh_main = home / ".zshrc"
    codex_hooks = home / ".codex" / "hooks.json"
    claude_settings = home / ".claude" / "settings.json"

    tmux_text, shell_text = desired_aggregators(manifests)
    has_tmux = any(manifest.get("tmux") for _, manifest in manifests)
    has_shell = any(manifest.get("shell") for _, manifest in manifests)
    current_tmux_main = tmux_main.read_text(encoding="utf-8") if tmux_main.exists() else ""
    current_zsh_main = zsh_main.read_text(encoding="utf-8") if zsh_main.exists() else ""
    wanted_tmux_main = (
        desired_tmux_main(current_tmux_main, tmux_aggregate)
        if has_tmux
        else strip_managed_block(current_tmux_main)
    )
    wanted_zsh_main = (
        desired_zsh_main(current_zsh_main, shell_aggregate)
        if has_shell
        else strip_managed_block(current_zsh_main)
    )

    replacements = {"BIN_DIR": str(bin_dir), "REPO_ROOT": str(repo_root)}
    codex_before = load_json(codex_hooks)
    claude_before = load_json(claude_settings)
    codex_after = apply_fragments(
        codex_before, collect_fragments(manifests, "codex"), replacements
    )
    claude_after = apply_fragments(
        claude_before, collect_fragments(manifests, "claude"), replacements
    )
    links = add_shared_compatibility_links(
        desired_links(manifests, bin_dir), names, repo_root, bin_dir
    )
    previous_links = {
        Path(target): Path(source)
        for target, source in previous_state.get("links", {}).items()
    }
    stale_links = {
        target: source for target, source in previous_links.items() if target not in links
    }

    changes: list[str] = []
    for target, source in links.items():
        if not link_matches(target, source):
            changes.append(f"link {target} -> {source}")
    for target in stale_links:
        changes.append(f"unlink stale managed target {target}")
    if has_tmux and (
        not tmux_aggregate.exists()
        or tmux_aggregate.read_text(encoding="utf-8") != tmux_text
    ):
        changes.append(f"write {tmux_aggregate}")
    if not has_tmux and tmux_aggregate.exists():
        changes.append(f"remove {tmux_aggregate}")
    if has_shell and (
        not shell_aggregate.exists()
        or shell_aggregate.read_text(encoding="utf-8") != shell_text
    ):
        changes.append(f"write {shell_aggregate}")
    if not has_shell and shell_aggregate.exists():
        changes.append(f"remove {shell_aggregate}")
    if current_tmux_main != wanted_tmux_main:
        changes.append(f"update {tmux_main}")
    if current_zsh_main != wanted_zsh_main:
        changes.append(f"update {zsh_main}")
    if codex_before != codex_after:
        changes.append(f"merge hooks in {codex_hooks}")
    if claude_before != claude_after:
        changes.append(f"merge hooks in {claude_settings}")

    if changes:
        print("planned changes:")
        for change in changes:
            print(f"  - {change}")
    if codex_before != codex_after:
        print(hooks_diff(codex_before, codex_after, str(codex_hooks)))
    if claude_before != claude_after:
        print(hooks_diff(claude_before, claude_after, str(claude_settings)))
    if args.dry_run:
        if not changes:
            print(f"already up to date: {', '.join(names)}")
        return 0

    if not changes and previous_state and previous_schema >= STATE_SCHEMA and not removed:
        runtime_messages = reconcile_runtime(
            home=home,
            repo_root=repo_root,
            bin_dir=bin_dir,
            tmux_aggregate=tmux_aggregate,
            names=names,
            removed=[],
            previous_features=previous_features,
            migrate_legacy=False,
        )
        for message in runtime_messages:
            print(message)
        print(f"already up to date: {', '.join(names)}")
        return 0

    backup_root, stamp = create_backup_root(state_root)
    backup_paths(
        [
            tmux_main,
            zsh_main,
            codex_hooks,
            claude_settings,
            tmux_aggregate,
            shell_aggregate,
            *links.keys(),
            *stale_links.keys(),
        ],
        backup_root,
        home,
    )

    for target, source in links.items():
        replace_link(target, source)
    if has_tmux:
        atomic_write_text(tmux_aggregate, tmux_text)
    else:
        tmux_aggregate.unlink(missing_ok=True)
    if has_shell:
        atomic_write_text(shell_aggregate, shell_text)
    else:
        shell_aggregate.unlink(missing_ok=True)
    atomic_write_text(tmux_main, wanted_tmux_main)
    atomic_write_text(zsh_main, wanted_zsh_main)
    atomic_write_json(codex_hooks, codex_after)
    atomic_write_json(claude_settings, claude_after)

    runtime_messages = reconcile_runtime(
        home=home,
        repo_root=repo_root,
        bin_dir=bin_dir,
        tmux_aggregate=tmux_aggregate,
        names=names,
        removed=removed,
        previous_features=previous_features,
        migrate_legacy=bool(previous_state) and previous_schema < STATE_SCHEMA,
    )

    for target, source in stale_links.items():
        if not remove_recorded_link(target, source) and (target.exists() or target.is_symlink()):
            print(f"kept user-modified target: {target}")

    state = {
        "schema": STATE_SCHEMA,
        "repo_root": str(repo_root),
        "enabled_features": names,
        "backup_root": str(backup_root),
        "installed_at": stamp,
        "links": {str(target): str(source) for target, source in links.items()},
        "config": {},
    }
    for path in (tmux_aggregate, shell_aggregate):
        if path.exists():
            state["config"][str(path)] = sha256(path)
    atomic_write_json(state_path, state)
    for message in runtime_messages:
        print(message)
    print(f"installed: {', '.join(names)}")
    print(f"backup: {backup_root}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
