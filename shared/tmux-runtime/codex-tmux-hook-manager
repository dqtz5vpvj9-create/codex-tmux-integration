def tmux(socket: str, *args: str) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(
            ["tmux", "-S", socket, *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=TMUX_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def owned_hook_targets(socket: str, feature: str, hook_name: str) -> list[str]:
    result = tmux(socket, "show-hooks", "-g", hook_name)
    if result is None or result.returncode != 0:
        return []
    marker = f"CODEX_TMUX_HOOK={feature}"
    targets = []
    for line in result.stdout.splitlines():
        match = HOOK_LINE_RE.match(line.strip())
        if not match or marker not in match.group("command"):
            continue
        index = match.group("index")
        targets.append(f"{hook_name}[{index}]" if index is not None else hook_name)
    return targets


def remove_feature(socket: str, feature: str) -> int:
    removed = 0
    hook_names = {hook_name for hook_name, _ in FEATURE_HOOKS[feature]}
    for hook_name in hook_names:
        for target in owned_hook_targets(socket, feature, hook_name):
            result = tmux(socket, "set-hook", "-gu", target)
            if result is not None and result.returncode == 0:
                removed += 1
    return removed


def install_feature(socket: str, feature: str) -> int:
    remove_feature(socket, feature)
    installed = 0
    for hook_name, command in FEATURE_HOOKS[feature]:
        result = tmux(socket, "set-hook", "-ag", hook_name, command)
        if result is not None and result.returncode == 0:
            installed += 1
    register_socket(socket, server_pid(socket))
    return installed


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    parser.add_argument("operation", choices=("install", "remove", "list-owned"))
    parser.add_argument("feature", choices=tuple(FEATURE_HOOKS))
    parser.add_argument("--socket")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    socket = args.socket or socket_from_tmux_env()
    if not socket:
        return 0
    if args.operation == "install":
        install_feature(socket, args.feature)
    elif args.operation == "remove":
        remove_feature(socket, args.feature)
    else:
        for hook_name, _ in FEATURE_HOOKS[args.feature]:
            for target in owned_hook_targets(socket, args.feature, hook_name):
                print(target)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
