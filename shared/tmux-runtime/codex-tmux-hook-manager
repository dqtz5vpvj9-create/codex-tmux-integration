RUNTIME_ROOT = Path(__file__).resolve().parent
if str(RUNTIME_ROOT) not in sys.path:
    sys.path.insert(0, str(RUNTIME_ROOT))

from tmux_runtime import register_socket, server_pid, socket_from_tmux_env  # noqa: E402

TMUX_TIMEOUT_SECONDS = 1.0
HOOK_LINE_RE = re.compile(r"^(?P<name>[^\s\[]+)(?:\[(?P<index>\d+)\])?\s+(?P<command>.*)$")


def _bin(name: str) -> str:
    return str(Path.home() / ".local" / "bin" / name)


def _run_shell(
    feature: str,
    executable: str,
    *arguments: str,
    background: bool = True,
) -> str:
    words = ["env", f"CODEX_TMUX_HOOK={feature}", _bin(executable), *arguments]
    shell_command = " ".join(
        word if word.startswith("#{") and word.endswith("}") else shlex.quote(word)
        for word in words
    )
    command = "run-shell -b" if background else "run-shell"
    return f"{command} {shlex.quote(shell_command)}"


